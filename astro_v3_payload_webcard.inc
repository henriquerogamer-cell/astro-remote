lor:#d7b45f!important}.webGlobe{width:31px;height:31px;border-radius:50%;display:grid;place-items:center;border:1px solid #28634f;background:#12392d;color:#78e0ba;font-size:15px;flex:0 0 auto}.payloadTags{display:flex;gap:6px;flex-wrap:wrap;margin-top:12px}.pill{display:inline-flex;align-items:center;gap:5px;border-radius:999px;padding:5px 9px;background:#253345;color:#9fb2c8;font-size:9px;font-weight:800}.pill.run{background:#123a2c;color:#52d49c}.pill.source{background:#162f4d;color:#78b5f8}.pill.ver{background:#302b1b;color:#dec47a}.pill.web{background:#12392d;color:#78e0ba}.payloadBottom{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:auto;padding-top:13px}.payloadBottom .left{display:flex;gap:6px;flex-wrap:wrap}.runBtn{background:#2d8cff!important;border-color:#2d8cff!important}.stopBtn{background:#2a1418!important;border-color:#70323a!important;color:#ff6d79!important}.webBtn{background:#12392d!important;border-color:#28634f!important;color:#78e0ba!important;font-weight:850!important}.sourceCard{background:#101821;border:1px solid #29394c;border-radius:10px;padding:13px;margin-bottom:9px}.sourceTop{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.sourceUrl{color:#7395ba;font-size:10px;margin-top:5px;word-break:break-all}.empty{padding:28px;text-align:center;color:#8496ab}.subtabs{display:flex;gap:6px;margin:0 0 12px;flex-wrap:wrap}.subtabs button{background:#0e151e!important}.subtabs button.on{background:#1b3553!important;border-color:#31679f!important;color:#fff!important}@media(max-width:760px){.payloadGrid{grid-template-columns:1fr}.payloadPanelHead{align-items:flex-start;flex-direction:column}.filterRow .search{max-width:none;width:100%}}"
