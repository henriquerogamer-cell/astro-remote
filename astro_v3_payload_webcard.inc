"<script>"
"let P=[],S=[],W=[],A=[],T='all',rel={};const E=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));const F=n=>{let u=['B','KB','MB','GB'],i=0;n=Number(n)||0;while(n>=1024&&i<3){n/=1024;i++}return n.toFixed(i?1:0)+' '+u[i]};"
"function note(t,b=false){msg.innerHTML=t?`<div class='notice ${b?'bad':'good'}'>${E(t)}</div>`:''}"
