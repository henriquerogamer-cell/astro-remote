"function srcFor(n){n=(n||'').toLowerCase();return S.find(s=>n.includes((s.pattern||'').toLowerCase()))}function webFor(x){let n=(x.name||'').toLowerCase(),pid=Number(x.pid)||0;return W.find(w=>w.online&&((w.payload&&String(w.payload).toLowerCase()===n)||(pid&&Number(w.pid)===pid)||(w.hint&&n.includes(String(w.hint).toLowerCase()))))}function localVer(n){let m=(n||'').match(/(?:^|[-_.])v?(\\d+(?:\\.\\d+)+(?:[-._a-z0-9]*)?)/i);return m?m[1]:''}"
"function counts(){nall.textContent=P.length;nrun.textContent=P.filter(x=>x.running).length;nfav.textContent=P.filter(x=>x.favorite).length}"
"async function loadAll(force){let [p,s,w,a]=await Promise.all([fetch('/api/payloads',{cache:'no-store'}).then(r=>r.json()),fetch('/api/payload-sources',{cache:'no-store'}).then(r=>r.json()),fetch('/api/webapps'+(force?'?scan=1':''),{cache:'no-store'}).then(r=>r.json()),fetch('/api/autoload',{cache:'no-store'}).then(r=>r.json())]);P=p.items||[];S=s.items||[];W=w.items||[];A=a.items||[];ps.textContent=(p.loader_port?'Loader '+p.loader_port+' pronto':'Loader offline')+' · '+P.length+' ELF';counts();await Promise.all(S.map(async x=>rel[x.index]=await release(x)));render()}"
"function tab(t){T=t;['all','run','fav'].forEach(x=>document.getElementById('t'+x)?.classList.toggle('on',x===t));render()}"
"function render(){if(T==='autoload')return renderAutoload();if(T==='sources')return renderSources();if(T==='web')return renderWeb();body.className='payloadGrid';sectionTitle.style.display='flex';let q=pq.value.toLowerCase(),a=P.filter(x=>(T!=='run'||x.running)&&(T!=='fav'||x.favorite)&&(!q||x.name.toLowerCase().includes(q)));a.sort((x,y)=>sort.value==='size'?y.size-x.size:x.name.localeCompare(y.name));shownCount.textContent=a.length;body.innerHTML=a.map(x=>{let s=srcFor(x.name),r=s?rel[s.index]:null,w=webFor(x),lv=localVer(x.name),ver=lv||r?.tag||'';return `<article class='payloadCard ${x.running?'running':''}'><div class='payloadTop'><div class='payloadIcon'>ϟ</div><div class='payloadInfo'><div class='payloadName'>${E(x.name)}</div><div class='payloadMeta'>${F(x.size)}${ver?' · '+E(ver):''}</div></div>${w?`<div class='webGlobe' title='Interface Web disponível'>🌐</div>`:''}<button class='payloadStar ${x.favorite?'on':''}' title='Favorito' onclick='fav(${JSON.stringify(x.name)})'>☆</button></div><div class='payloadTags'><span class='pill'>Baixado</span>${x.running?`<span class='pill run'>● Em execução</span>`:''}${w?`<span class='pill web'>Web disponível</span>`:''}${s?`<span class='pill source'>${E(s.name)}</span>`:''}${r?`<span class='pill ver'>Upstream ${E(r.tag)}</span>`:''}</div><div class='payloadBottom'><div class='left'><button class='ghost sm' onclick='linkSource(${JSON.stringify(x.name)})'>⋮ Fonte</button>${w?`<a class='btn webBtn sm' href='${E(w.route)}'>🌐 Acessar</a>`:''}</div>${x.running?`<button class='stopBtn sm' onclick='stopP(${JSON.stringify(x.name)})'>⊗ Parar</button>`:`<button class='runBtn sm' onclick='launch(${JSON.stringify(x.path)})'>▷ Executar</button>`}</div></article>`}).join('')||`<div class='empty'>Nenhum payload nessa seleção.</div>`}"
"function renderAutoload(){sectionTitle.style.display='none';body.className='';let opts=P.map(x=>`<option value='${E(x.name)}'>${E(x.name)}</option>`).join('');body.innerHTML=`<div class='subtabs'><button class='on'>Autoloader</button><button onclick=\"tab('sources')\">Fontes de ELF</button><button onclick=\"tab('web')\">Web fallback</button></div><article class='sourceCard'><b>Adicionar à fila</b><div class='filterRow' style='margin-top:10px'><select id='autoPayload'>${opts}</select><input id='autoDelay' type='number' min='0' max='300' value='3' style='width:130px' title='Intervalo após este ELF'><button class='primary' onclick='addAuto()'>＋ Adicionar</button></div><div class='muted' style='margin-top:7px'>Intervalo em segundos antes de iniciar o próximo ELF.</div></article>`+A.map((x,i)=>`<article class='sourceCard'><div class='sourceTop'><div><b>${i+1}. ${E(x.name)}</b><div class='muted' style='margin-top:5px'>Intervalo: ${x.delay} segundo(s)</div></div><div class='toolbar'><button ${i===0?'disabled':''} onclick='moveAuto(${i},${i-1})'>↑</button><button ${i===A.length-1?'disabled':''} onclick='moveAuto(${i},${i+1})'>↓</button><button class='danger' onclick='delAuto(${i})'>Remover</button></div></div></article>`).join('')+(A.length?'':`<div class='empty'>Nenhum payload configurado no autoloader.</div>`)}async function addAuto(){let n=autoPayload.value,d=Math.max(0,Math.min(300,Number(autoDelay.value)||0));await fetch('/api/autoload?action=add&name='+encodeURIComponent(n)+'&delay='+d,{method:'POST'});await loadAll(false);T='autoload';render()}async function delAuto(i){await fetch('/api/autoload?action=delete&index='+i,{method:'POST'});await loadAll(false);T='autoload';render()}async function moveAuto(i,to){await fetch('/api/autoload?action=move&index='+i+'&to='+to,{method:'POST'});await loadAll(false);T='autoload';render()}"
"function renderSources(){sectionTitle.style.display='none';body.className='';body.innerHTML=`<div class='subtabs'><button class='on'>Fontes de ELF</button><button onclick=\"tab('web')\">Web fallback</button><button class='primary' onclick='addSource()'>＋ Adicionar fonte por URL</button></div>`+S.map(s=>{let r=rel[s.index];return `<article class='sourceCard'><div class='sourceTop'><div><b>${E(s.name)}</b><div class='sourceUrl'>${E(s.url)}</div><div class='muted' style='margin-top:5px'>Associa ELFs contendo: ${E(s.pattern)}</div></div><div class='toolbar'>${r?`<span class='pill ver'>${E(r.tag)}</span>`:`<span class='pill'>Versão indisponível</span>`}<a class='btn sm' target='_blank' href='${E(s.url)}'>Abrir fonte</a><button class='danger sm' onclick='delSource(${s.index})'>Remover</button></div></div></article>`}).join('')}"
"function renderWeb(){sectionTitle.style.display='none';body.className='';body.innerHTML=`<div class='subtabs'><button onclick=\"tab('sources')\">Fontes de ELF</button><button class='on'>Web fallback</button><button class='primary' onclick='addWeb()'>＋ Registrar manualmente</button><button onclick='loadAll(true)'>↻ Detectar agora</button></div>`+W.map(w=>`<article class='sourceCard'><div class='sourceTop'><div><b>${E(w.label)}</b><div class='muted' style='margin-top:5px'>${w.detected?'Detectado automaticamente':'Cadastro manual'} · ${w.payload?E(w.payload)+' · ':''}porta interna ${w.port}</div></div><div class='toolbar'><span class='status ${w.online?'on':''}'>${w.online?'ONLINE':'OFFLINE'}</span>${w.online?`<a class='btn webBtn sm' href='${E(w.route)}'>🌐 Acessar</a>`:''}</div></div></article>`).join('')}"
"async function launch(p){note('Enviando ELF...');let r=await fetch('/api/payloads/launch?path='+encodeURIComponent(p),{method:'POST'});note(r.ok?'Payload enviado.':'Falha ao executar.',!r.ok);setTimeout(()=>loadAll(true),700)}async function stopP(n){await fetch('/api/payloads/stop?name='+encodeURIComponent(n),{method:'POST'});setTimeout(()=>loadAll(true),300)}async function fav(n){await fetch('/api/payloads/favorite?name='+encodeURIComponent(n),{method:'POST'});loadAll(false)}"
"async function addSource(pref=''){let url=prompt('URL do repositório GitHub/Gitea:',pref);if(!url)return;let bits=url.replace(/\\/$/,'').split('/'),name=prompt('Nome da fonte:',bits[bits.length-1]||'Fonte');if(!name)return;let pat=prompt('Texto que identifica o ELF local:',bits[bits.length-1]||name);if(!pat)return;await fetch(`/api/payload-sources/add?name=${encodeURIComponent(name)}&url=${encodeURIComponent(url)}&pattern=${encodeURIComponent(pat)}`,{method:'POST'});await loadAll(false);T='sources';render()}function linkSource(n){addSource('')}async function delSource(i){if(confirm('Remover esta fonte?')){await fetch('/api/payload-sources/delete?index='+i,{method:'POST'});loadAll(false)}}"
"async function addWeb(){let label=prompt('Nome da interface Web:');if(!label)return;let port=prompt('Porta interna do payload:');if(!port)return;let hint=prompt('Texto do nome/processo para associar:',label.toLowerCase().replace(/[^a-z0-9]+/g,''));if(!hint)return;let slug=label.toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');await fetch(`/api/webapps/add?slug=${encodeURIComponent(slug)}&label=${encodeURIComponent(label)}&port=${encodeURIComponent(port)}&hint=${encodeURIComponent(hint)}`,{method:'POST'});await loadAll(true);T='web';render()}"
"up.onchange=()=>{let f=up.files[0];if(!f)return;let x=new XMLHttpRequest();x.open('POST','/api/payloads/upload?name='+encodeURIComponent(f.name));x.upload.onprogress=e=>{if(e.lengthComputable)note('Upload '+Math.round(e.loaded*100/e.total)+'%')};x.onload=()=>{note(x.status===200?'ELF enviado.':'Falha no upload.',x.status!==200);loadAll(true)};x.send(f)};loadAll(false);"
"</script>";
  strncat(page,b,sizeof(page)-strlen(page)-1);
  v3_page_end(page,sizeof(page));
  send_text(fd,"200 OK","text/html; charset=utf-8",NULL,page);
}
