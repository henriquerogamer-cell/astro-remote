/* FW 12-safe flow: download PKGs to a writable USB for Debug Settings. */
#include <pthread.h>
typedef struct { pthread_mutex_t lock;int state;unsigned long long now,total;char name[192],url[512],path[512],detail[256]; } astro_pkg_dl_t;
static astro_pkg_dl_t astro_pkg_dl={.lock=PTHREAD_MUTEX_INITIALIZER};

static int astro_pkg_safe_token(const char *s,size_t max){size_t n=s?strlen(s):0;if(!n||n>=max)return 0;for(size_t i=0;i<n;i++){unsigned char c=s[i];if(!(isalnum(c)||c=='.'||c=='_'||c=='-'))return 0;}return 1;}
static int astro_pkg_find_usb(char *out,size_t os){for(int i=0;i<8;i++){char root[64],probe[128];struct stat st;snprintf(root,sizeof(root),"/mnt/usb%d",i);if(stat(root,&st)||!S_ISDIR(st.st_mode))continue;snprintf(probe,sizeof(probe),"%s/.astro-write-%d",root,(int)getpid());int f=open(probe,O_WRONLY|O_CREAT|O_EXCL,0600);if(f<0)continue;close(f);unlink(probe);snprintf(out,os,"%s",root);return 1;}if(os)out[0]=0;return 0;}
static size_t astro_pkg_write(void *p,size_t s,size_t n,void *u){return fwrite(p,s,n,(FILE*)u);}
static int astro_pkg_progress(void *u,curl_off_t total,curl_off_t now,curl_off_t ut,curl_off_t un){(void)u;(void)ut;(void)un;pthread_mutex_lock(&astro_pkg_dl.lock);astro_pkg_dl.total=total>0?(unsigned long long)total:0;astro_pkg_dl.now=now>0?(unsigned long long)now:0;pthread_mutex_unlock(&astro_pkg_dl.lock);return 0;}
static void *astro_pkg_worker(void *u){(void)u;char url[512],path[512],tmp[544];pthread_mutex_lock(&astro_pkg_dl.lock);snprintf(url,sizeof(url),"%s",astro_pkg_dl.url);snprintf(path,sizeof(path),"%s",astro_pkg_dl.path);pthread_mutex_unlock(&astro_pkg_dl.lock);snprintf(tmp,sizeof(tmp),"%s.part",path);unlink(tmp);FILE *f=fopen(tmp,"wb");CURLcode cr=CURLE_WRITE_ERROR;long code=0;if(f){CURL *c=curl_easy_init();if(c){curl_easy_setopt(c,CURLOPT_URL,url);curl_easy_setopt(c,CURLOPT_FOLLOWLOCATION,1L);curl_easy_setopt(c,CURLOPT_FAILONERROR,1L);curl_easy_setopt(c,CURLOPT_CONNECTTIMEOUT,20L);curl_easy_setopt(c,CURLOPT_USERAGENT,"Astro/3 PS5 USB PKG Downloader");curl_easy_setopt(c,CURLOPT_WRITEFUNCTION,astro_pkg_write);curl_easy_setopt(c,CURLOPT_WRITEDATA,f);curl_easy_setopt(c,CURLOPT_NOPROGRESS,0L);curl_easy_setopt(c,CURLOPT_XFERINFOFUNCTION,astro_pkg_progress);cr=curl_easy_perform(c);curl_easy_getinfo(c,CURLINFO_RESPONSE_CODE,&code);curl_easy_cleanup(c);}fflush(f);fsync(fileno(f));fclose(f);}int ok=cr==CURLE_OK&&code>=200&&code<300&&rename(tmp,path)==0;if(!ok)unlink(tmp);pthread_mutex_lock(&astro_pkg_dl.lock);astro_pkg_dl.state=ok?2:3;if(ok)snprintf(astro_pkg_dl.detail,sizeof(astro_pkg_dl.detail),"Download concluído. Abra Debug Settings > Game > Package Installer.");else snprintf(astro_pkg_dl.detail,sizeof(astro_pkg_dl.detail),"Falha no download (curl %d, HTTP %ld).",(int)cr,code);pthread_mutex_unlock(&astro_pkg_dl.lock);return NULL;}

static void v3_pkg_install_api(int fd,const char *target){char usb[64];if(!astro_pkg_find_usb(usb,sizeof(usb))){send_text(fd,"409 Conflict","application/json; charset=utf-8",NULL,"{\"ok\":false,\"error\":\"usb_required\",\"detail\":\"Conecte um pendrive ou HD USB gravável para liberar o download.\"}");return;}char id[64]={0},version[48]={0},name[192]={0},kind[24]="app",url[512],file[160];query_value(target,"id",id,sizeof(id));query_value(target,"version",version,sizeof(version));query_value(target,"name",name,sizeof(name));query_value(target,"kind",kind,sizeof(kind));if(!strcmp(kind,"store")){snprintf(url,sizeof(url),"https://pkg-zone.com/update/Store-R2-PS5.pkg");snprintf(name,sizeof(name),"Homebrew Store");snprintf(file,sizeof(file),"Homebrew-Store-PS5.pkg");}else{if(!astro_pkg_safe_token(id,sizeof(id))||!astro_pkg_safe_token(version,sizeof(version))){send_text(fd,"400 Bad Request","application/json",NULL,"{\"ok\":false,\"error\":\"invalid_package\"}");return;}snprintf(url,sizeof(url),"https://pkg-zone.com/download/ps5/%s/%s",id,version);snprintf(file,sizeof(file),"%s-%s.pkg",id,version);if(!name[0])snprintf(name,sizeof(name),"%s",id);}pthread_mutex_lock(&astro_pkg_dl.lock);if(astro_pkg_dl.state==1){pthread_mutex_unlock(&astro_pkg_dl.lock);send_text(fd,"409 Conflict","application/json; charset=utf-8",NULL,"{\"ok\":false,\"error\":\"download_busy\",\"detail\":\"Já existe um PKG sendo baixado.\"}");return;}astro_pkg_dl.state=1;astro_pkg_dl.now=astro_pkg_dl.total=0;snprintf(astro_pkg_dl.name,sizeof(astro_pkg_dl.name),"%s",name);snprintf(astro_pkg_dl.url,sizeof(astro_pkg_dl.url),"%s",url);snprintf(astro_pkg_dl.path,sizeof(astro_pkg_dl.path),"%s/%s",usb,file);snprintf(astro_pkg_dl.detail,sizeof(astro_pkg_dl.detail),"Baixando para o USB...");pthread_mutex_unlock(&astro_pkg_dl.lock);pthread_t th;if(pthread_create(&th,NULL,astro_pkg_worker,NULL)){pthread_mutex_lock(&astro_pkg_dl.lock);astro_pkg_dl.state=3;pthread_mutex_unlock(&astro_pkg_dl.lock);send_text(fd,"500 Internal Server Error","application/json",NULL,"{\"ok\":false,\"error\":\"thread_failed\"}");return;}pthread_detach(th);char nm[512],path[1024],j[1800];json_escape(name,nm,sizeof(nm));json_escape(astro_pkg_dl.path,path,sizeof(path));snprintf(j,sizeof(j),"{\"ok\":true,\"status\":\"downloading\",\"name\":\"%s\",\"path\":\"%s\"}",nm,path);send_text(fd,"202 Accepted","application/json; charset=utf-8",NULL,j);}
static void v3_pkg_status_api(int fd){char usb[64],nm[512],path[1024],detail[768],j[2600];int present=astro_pkg_find_usb(usb,sizeof(usb));pthread_mutex_lock(&astro_pkg_dl.lock);int state=astro_pkg_dl.state;unsigned long long now=astro_pkg_dl.now,total=astro_pkg_dl.total;json_escape(astro_pkg_dl.name,nm,sizeof(nm));json_escape(astro_pkg_dl.path,path,sizeof(path));json_escape(astro_pkg_dl.detail,detail,sizeof(detail));pthread_mutex_unlock(&astro_pkg_dl.lock);unsigned pct=total?(unsigned)(now*100/total):0;if(pct>100)pct=100;snprintf(j,sizeof(j),"{\"ok\":true,\"usb_present\":%s,\"usb\":\"%s\",\"active\":%s,\"state\":\"%s\",\"name\":\"%s\",\"path\":\"%s\",\"progress\":%u,\"downloaded\":%llu,\"total\":%llu,\"detail\":\"%s\"}",present?"true":"false",present?usb:"",state==1?"true":"false",state==1?"downloading":state==2?"ready":state==3?"error":"idle",nm,path,pct,now,total,detail);send_text(fd,"200 OK","application/json; charset=utf-8",NULL,j);}
