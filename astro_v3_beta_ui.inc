static void v3_files_page(int fd)
{
  char page[90000];v3_page_start(page,sizeof(page),"Arquivos","files");const char*b=
"<div class='head'><div><h1>Arquivos</h1><p>Navegação, upload, download e operações diretas no armazenamento do PS5.</p></div><div class='toolbar'><input id='fu' type='file' multiple hidden><button onclick='newFolder()'>＋ Pasta</button><button class='primary' onclick='fu.click()'>⇧ Upload</button></div></div><div class='storage'><div class='storagebox'><b>Internal data</b><div id='sd' class='muted'>...</div><div class='barline'><div id='sdb' class='barfill'></div></div></div><div class='storagebox'><b>User storage</b><div id='su' class='muted'>...</div><div class='barline'><div id='sub' class='barfill'></div></div></div></div><section class='panel'><div class='pathbar'><button onclick='upDir()'>↑</button><input id='path' value='/data'><button onclick='loadDir()'>Abrir</button></div><div class='toolbar' style='margin-bottom:11px'><input id='fq' class='search' placeholder='Buscar...' oninput='renderF()'><button class='ghost' onclick='loadDir()'>↻</button><span id='prog' class='muted'></span></div><div class='tablewrap'><table><thead><tr><th>Nome</th><th>Tamanho</th><th>Modificado</th><th>Perm.</th><th>Ações</th></tr></thead><tbody id='rows'></tbody></table></div></section>"
"<script>let FI=[],CP='/data';const F=n=>{let u=['B','KB','MB','GB','TB'],i=0;n=Number(n)||0;while(n>=1024&&i<4){n/=1024;i++}return n.toFixed(i?1:0)+' '+u[i]};const J=(a,b)=>a.replace(/\\/$/,'')+'/'+b;async function storage(){let j=await fetch('/api/storage').then(r=>r.json());for(const k of ['data','user']){let x=j[k],used=x.total-x.free,p=x.total?Math.round(used*100/x.total):0;document.getElementById(k==='data'?'sd':'su').textContent=F(x.free)+' livres de '+F(x.total);document.getElementById(k==='data'?'sdb':'sub').style.width=p+'%'}}async function loadDir(p){p=p||path.value;let j=await fetch('/api/files?path='+encodeURIComponent(p),{cache:'no-store'}).then(r=>r.json());if(!j.ok)return alert('Não foi possível abrir '+p);CP=j.path;FI=j.items||[];path.value=CP;renderF()}function renderF(){let q=fq.value.toLowerCase(),a=FI.filter(x=>!q||x.name.toLowerCase().includes(q));a.sort((x,y)=>x.dir===y.dir?x.name.localeCompare(y.name):(x.dir?-1:1));rows.innerHTML=a.map(x=>{let p=J(CP,x.name);return`<tr><td class='fname'>${x.dir?`<span class='link' onclick='loadDir(${JSON.stringify(p)})'>📁 ${x.name}</span>`:`📄 ${x.name}`}</td><td>${x.dir?'—':F(x.size)}</td><td>${new Date(x.mtime*1000).toLocaleString()}</td><td>${x.mode||''}</td><td><div class='toolbar'>${x.dir?'':`<a class='btn sm ghost' href='/api/files/download?path=${encodeURIComponent(p)}'>Baixar</a>`}<button class='sm' onclick='ren(${JSON.stringify(p)},${JSON.stringify(x.name)})'>Renomear</button><button class='danger sm' onclick='del(${JSON.stringify(p)})'>Excluir</button></div></td></tr>`}).join('')}function upDir(){if(CP==='/')return;loadDir(CP.replace(/\\/+$/,'').replace(/\\/[^/]+$/,'')||'/')}async function post(u){let r=await fetch(u,{method:'POST'});if(!r.ok)throw 0}async function newFolder(){let n=prompt('Nome da pasta:');if(n){await post('/api/files/mkdir?path='+encodeURIComponent(J(CP,n)));loadDir()}}async function ren(p,n){let v=prompt('Novo nome:',n);if(v&&v!==n){await post('/api/files/rename?path='+encodeURIComponent(p)+'&name='+encodeURIComponent(v));loadDir()}}async function del(p){if(confirm('Excluir '+p+'?')){await post('/api/files/delete?path='+encodeURIComponent(p));loadDir()}}function send(f){return new Promise((ok,no)=>{let x=new XMLHttpRequest();x.open('POST','/api/files/upload?path='+encodeURIComponent(J(CP,f.name)));x.upload.onprogress=e=>{if(e.lengthComputable)prog.textContent=f.name+' '+Math.round(e.loaded*100/e.total)+'%'};x.onload=()=>x.status===200?ok():no();x.send(f)})}fu.onchange=async()=>{for(const f of fu.files)await send(f);prog.textContent='Upload concluído';loadDir();storage()};loadDir();storage()</script>";strncat(page,b,sizeof(page)-strlen(page)-1);v3_page_end(page,sizeof(page));send_text(fd,"200 OK","text/html; charset=utf-8",NULL,page);
}

