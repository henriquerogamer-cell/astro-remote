/* Astro V3 beta interface: functional control-deck layout. */

static const char *v3_css=
"*{box-sizing:border-box}:root{--bg:#0b1017;--panel:#121a25;--panel2:#172231;--line:#263548;--text:#edf3fb;--muted:#8ea0b6;--blue:#2d8cff;--green:#31d08b;--red:#ef6670;--gold:#d7b45f}"
"body{margin:0;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Arial,sans-serif}a{color:inherit;text-decoration:none}button,input,select{font:inherit}.shell{width:min(1500px,calc(100% - 28px));margin:auto;padding-bottom:48px}"
".top{height:68px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}.brand{font-weight:900;letter-spacing:.19em;font-size:17px}.brand small{display:block;color:#65778c;font-size:9px;letter-spacing:.23em;margin-top:3px}.profile{display:flex;align-items:center;gap:9px}.avatar{width:38px;height:38px;border-radius:50%;object-fit:cover;background:#172231;border:1px solid #34465b}.avatarFallback{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:#172231;color:#85b9fa;font-weight:900}.pname{font-size:12px;font-weight:800}.pid{font-size:9px;color:var(--muted)}"
".nav{height:54px;display:flex;align-items:center;gap:3px;overflow-x:auto;border-bottom:1px solid var(--line);margin-bottom:20px}.nav a{white-space:nowrap;padding:9px 12px;border-radius:8px;color:#8da0b6;font-size:12px;font-weight:750}.nav a.active,.nav a:hover{background:#172334;color:#fff}.nav a.active{box-shadow:inset 3px 0 var(--blue)}"
".head{display:flex;align-items:flex-end;justify-content:space-between;gap:15px;margin-bottom:15px}.head h1{margin:0;font-size:24px}.head p{margin:5px 0 0;color:var(--muted);font-size:12px}.toolbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.btn,button{border:1px solid #35506c;background:#17283b;color:#edf5ff;border-radius:8px;padding:9px 12px;font-size:11px;font-weight:750;cursor:pointer}.btn:hover,button:hover{background:#20374f}.primary{background:var(--blue)!important;border-color:var(--blue)!important}.danger{background:#30161a!important;border-color:#6c3038!important;color:#ff9da5!important}.ghost{background:transparent!important;border-color:#2b394a!important;color:#a8b7c9!important}.green{background:#12392d!important;border-color:#28634f!important;color:#78e0ba!important}.sm{padding:7px 9px;font-size:10px}"
"input,select{background:#0a1119;border:1px solid #2b3b4e;color:var(--text);border-radius:8px;padding:9px 10px;outline:none}input:focus,select:focus{border-color:#4387cb}.search{min-width:230px;flex:1}.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:12px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:15px}.c3{grid-column:span 3}.c4{grid-column:span 4}.c6{grid-column:span 6}.c8{grid-column:span 8}.full{grid-column:1/-1}.kicker{font-size:9px;color:#657a91;font-weight:850;letter-spacing:.12em;text-transform:uppercase}.metric{font-size:23px;font-weight:850;margin:7px 0}.muted{color:var(--muted);font-size:11px;line-height:1.5}.status{display:inline-flex;align-items:center;gap:6px;font-size:10px;font-weight:850}.status:before{content:'';width:7px;height:7px;border-radius:50%;background:#667587}.status.on{color:var(--green)}.status.on:before{background:var(--green);box-shadow:0 0 8px #35d09166}"
".cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(285px,1fr));gap:10px}.card{background:#0e161f;border:1px solid #263547;border-radius:11px;padding:13px;position:relative}.card:hover{border-color:#3a536f}.card.run{border-color:#205b45}.card h3{font-size:13px;margin:0 0 5px}.meta{font-size:10px;color:var(--muted)}.row{display:flex;gap:7px;align-items:center;flex-wrap:wrap;margin-top:11px}.badge{display:inline-block;padding:3px 7px;border-radius:999px;background:#202e3e;color:#9db1c8;font-size:9px;font-weight:800}.badge.run{background:#123c2e;color:#63dcae}.badge.blue{background:#152f50;color:#79b8ff}.badge.gold{background:#40351c;color:#e2c779}.star{position:absolute;right:10px;top:9px;border:0;background:none!important;color:#64758a;font-size:18px;padding:0}.star.on{color:var(--gold)}"
".tabs{display:flex;gap:4px;flex-wrap:wrap;margin-bottom:12px}.tab{padding:7px 11px;border:1px solid #293a4d;border-radius:8px;color:#8799ad;font-size:11px;cursor:pointer}.tab.on{background:#1b3553;color:#fff;border-color:#31679f}.notice{padding:10px 12px;border:1px solid #31455c;border-radius:9px;background:#0f1924;color:#93a8bf;font-size:11px}.notice.good{border-color:#285b48;color:#74d9b2;background:#10231d}.notice.bad{border-color:#67333a;color:#ed9ba2;background:#251317}.tablewrap{overflow:auto;border:1px solid #233143;border-radius:10px}table{width:100%;border-collapse:collapse;font-size:11px}th,td{padding:10px 11px;text-align:left;border-bottom:1px solid #1f2b39;white-space:nowrap}th{color:#7e90a5;background:#0d141c;position:sticky;top:0}.fname{min-width:260px;white-space:normal}.link{color:#85bbff;cursor:pointer}.pathbar{display:flex;gap:7px;margin-bottom:11px}.pathbar input{flex:1}"
".storage{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px}.storagebox{background:#111a25;border:1px solid var(--line);border-radius:11px;padding:13px}.barline{height:5px;background:#263445;border-radius:99px;overflow:hidden;margin-top:9px}.barfill{height:100%;background:var(--blue)}"
".savegroup{background:#0e161f;border:1px solid #263547;border-radius:11px;padding:12px;margin-bottom:9px}.savehead{display:flex;gap:12px;align-items:center}.gameico{width:56px;height:56px;border-radius:9px;object-fit:cover;background:#17273b;border:1px solid #2d4055}.gamefallback{width:56px;height:56px;border-radius:9px;background:#17273b;display:grid;place-items:center;color:#7faee6;font-weight:900}.saveinfo{flex:1;min-width:0}.saveinfo b{font-size:13px}.saveinfo span{display:block;color:var(--muted);font-size:10px;margin-top:3px}.saveitem{display:flex;align-items:center;gap:8px;border-top:1px solid #202e3e;margin-top:10px;padding-top:10px}.saveitem .grow{flex:1}.storegrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:11px}.pkg{background:#0e161f;border:1px solid #263547;border-radius:11px;overflow:hidden}.pkgimg{height:145px;background:#151f2c center/cover no-repeat}.pkgb{padding:12px}.pkgb h3{font-size:13px;margin:0 0 5px}.foot{text-align:center;color:#485a70;font-size:9px;margin-top:22px}"
"@media(max-width:900px){.c3,.c4,.c6,.c8{grid-column:1/-1}.head{align-items:flex-start;flex-direction:column}.storage{grid-template-columns:1fr}.savehead{align-items:flex-start}.shell{width:min(100% - 18px,1500px)}.profile .pid{display:none}}";

static void v3_profile_values(char uid[16],char name[64],int *has_avatar){char av[256];uid[0]=name[0]=0;if(v3_foreground_user(uid,name,av)!=0){snprintf(name,64,"PS5");snprintf(uid,16,"--------");*has_avatar=0;return;}struct stat st;*has_avatar=(stat(av,&st)==0&&S_ISREG(st.st_mode));}

static void v3_page_start(char*out,size_t os,const char*title,const char*active)
{
  char uid[16],name[64],en[160];int av=0;v3_profile_values(uid,name,&av);json_escape(name,en,sizeof(en));snprintf(out,os,"<!doctype html><html lang='pt-BR'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>%s · Astro</title><style>%s</style></head><body><main class='shell'><header class='top'><div class='brand'>ASTRO<small>PS5 CONTROL DECK · V3 BETA</small></div><a class='profile' href='/profile'>%s<div><div class='pname'>%s</div><div class='pid'>User %s</div></div></a></header><nav class='nav'><a class='%s' href='/dashboard'>Painel</a><a class='%s' href='/payloads'>Payloads</a><a class='%s' href='/files'>Arquivos</a><a class='%s' href='/saves'>Saves</a><a class='%s' href='/homebrew'>Homebrew</a><a class='%s' href='/processes'>Processos</a><a class='%s' href='/profile'>Perfil</a><a class='%s' href='/settings'>Ajustes</a><a href='/logout'>Sair</a></nav>",title,v3_css,av?"<img class='avatar' src='/api/profile/avatar?t=1' onerror=\"this.style.display='none'\">":"<div class='avatarFallback'>A</div>",en,uid,!strcmp(active,"dashboard")?"active":"",!strcmp(active,"payloads")?"active":"",!strcmp(active,"files")?"active":"",!strcmp(active,"saves")?"active":"",!strcmp(active,"homebrew")?"active":"",!strcmp(active,"processes")?"active":"",!strcmp(active,"profile")?"active":"",!strcmp(active,"settings")?"active":"");
}
static void v3_page_end(char*out,size_t os){strncat(out,"<div class='foot'>ASTRO v3 beta · um painel, sem portas espalhadas</div></main></body></html>",os-strlen(out)-1);}

static void send_setup(int fd,const char*error){char p[18000];snprintf(p,sizeof(p),"<!doctype html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><style>%s .box{width:min(450px,calc(100%% - 20px));margin:8vh auto;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:25px}.field{margin:11px 0}.field label{display:block;font-size:10px;color:var(--muted);margin-bottom:5px}.err{color:#ff9aa3;font-size:11px}</style><title>Astro</title></head><body><section class='box'><div class='kicker'>PRIMEIRO ACESSO</div><h1>Crie seu acesso</h1><p class='muted'>O mesmo login vale local e remotamente.</p>%s<form method='POST' action='/setup'><div class='field'><label>Usuário</label><input name='username' minlength='3' maxlength='47' required></div><div class='field'><label>Senha</label><input name='password' type='password' minlength='8' maxlength='95' required></div><div class='field'><label>Confirmar senha</label><input name='password2' type='password' minlength='8' maxlength='95' required></div><button class='primary'>Criar acesso</button></form></section></body></html>",v3_css,error?error:"");send_text(fd,"200 OK","text/html; charset=utf-8",NULL,p);}
static void send_login(int fd,int bad){char p[16000];snprintf(p,sizeof(p),"<!doctype html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><style>%s .box{width:min(420px,calc(100%% - 20px));margin:10vh auto;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:25px}.field{margin:11px 0}.field label{display:block;font-size:10px;color:var(--muted);margin-bottom:5px}.err{color:#ff9aa3;font-size:11px}</style><title>Astro</title></head><body><section class='box'><div class='kicker'>PS5 CONTROL DECK</div><h1>ASTRO</h1>%s<form method='POST' action='/login'><div class='field'><label>Usuário</label><input name='username' required></div><div class='field'><label>Senha</label><input type='password' name='password' required></div><button class='primary'>Entrar</button></form></section></body></html>",v3_css,bad?"<p class='err'>Usuário ou senha inválidos.</p>":"");send_text(fd,"200 OK","text/html; charset=utf-8",NULL,p);}

static void v3_dashboard(int fd)
{
  char page[60000];v3_page_start(page,sizeof(page),"Painel","dashboard");const char*b=
"<div class='head'><div><h1>Painel</h1><p>Resumo do PS5, payloads ativos, armazenamento e atalhos úteis.</p></div><button onclick='loadDash()'>↻ Atualizar</button></div>"
"<section class='grid'><article class='panel c3'><div class='kicker'>ELF LOADER</div><div id='dloader' class='metric'>...</div><div id='dloadst' class='status'>consultando</div></article><article class='panel c3'><div class='kicker'>PAYLOADS RODANDO</div><div id='drun' class='metric'>...</div><p class='muted'>Processos associados à biblioteca do Astro.</p></article><article class='panel c3'><div class='kicker'>SAVES</div><div id='dsaves' class='metric'>...</div><p id='dusers' class='muted'>...</p></article><article class='panel c3'><div class='kicker'>ARMAZENAMENTO</div><div id='dfree' class='metric'>...</div><p class='muted'>Livre em /data.</p></article>"
"<article class='panel c4'><div class='kicker'>ATALHOS</div><div class='row'><a class='btn primary' href='/payloads'>Payloads</a><a class='btn' href='/files'>Arquivos</a><a class='btn' href='/saves'>Saves</a><a class='btn' href='/homebrew'>Homebrew</a></div></article><article class='panel c8'><div class='kicker'>INTERFACES WEB ATIVAS</div><div id='dweb' class='row'><span class='muted'>Consultando...</span></div></article><article class='panel full'><div class='kicker'>PAYLOADS EM EXECUÇÃO</div><div id='dplist' class='cards' style='margin-top:10px'></div></article></section>"
"<script>const F=n=>{if(!n)return'0 B';let u=['B','KB','MB','GB','TB'],i=0;while(n>=1024&&i<4){n/=1024;i++}return n.toFixed(i?1:0)+' '+u[i]};async function loadDash(){try{const [p,s,u,w,st]=await Promise.all([fetch('/api/payloads').then(x=>x.json()),fetch('/api/saves').then(x=>x.json()),fetch('/api/users').then(x=>x.json()),fetch('/api/webapps').then(x=>x.json()),fetch('/api/storage').then(x=>x.json())]);let run=(p.items||[]).filter(x=>x.running);drun.textContent=run.length;dloader.textContent=p.loader_port?'PRONTO':'OFFLINE';dloadst.textContent=p.loader_port?'porta interna '+p.loader_port:'loader indisponível';dloadst.className='status '+(p.loader_port?'on':'');dsaves.textContent=(s.items||[]).length;dusers.textContent=(u.users||[]).length+' usuários encontrados';dfree.textContent=F(st.data?.free||0);dplist.innerHTML=run.length?run.map(x=>`<article class='card run'><h3>⚡ ${x.name}</h3><div class='meta'>PID ${x.pid||'?'} · ${F(x.size||0)}</div><div class='row'><span class='badge run'>Em execução</span></div></article>`).join(''):`<div class='notice'>Nenhum payload da biblioteca está rodando.</div>`;let on=(w.items||[]).filter(x=>x.online);dweb.innerHTML=on.length?on.map(x=>`<a class='btn green sm' href='${x.route}'>${x.label}</a>`).join(''):`<span class='muted'>Nenhuma interface web registrada está online.</span>`}catch(e){console.log(e)}}loadDash()</script>";strncat(page,b,sizeof(page)-strlen(page)-1);v3_page_end(page,sizeof(page));send_text(fd,"200 OK","text/html; charset=utf-8",NULL,page);
}

static void v3_payloads_page(int fd)
{
  char page[110000];v3_page_start(page,sizeof(page),"Payloads","payloads");const char*b=
"<div class='head'><div><h1>Payloads</h1><p>Biblioteca local, versões upstream, fontes por URL e interfaces web autenticadas.</p></div><div class='toolbar'><input id='up' type='file' accept='.elf' hidden><button class='primary' onclick='up.click()'>⇧ Enviar ELF</button><button onclick='addSource()'>＋ Fonte por URL</button><button onclick='addWeb()'>＋ Web UI</button></div></div>"
"<div class='tabs'><button class='tab on' data-t='all' onclick=\"tab('all',this)\">Todos</button><button class='tab' data-t='run' onclick=\"tab('run',this)\">Em execução</button><button class='tab' data-t='fav' onclick=\"tab('fav',this)\">Favoritos</button><button class='tab' data-t='sources' onclick=\"tab('sources',this)\">Fontes de ELF</button><button class='tab' data-t='web' onclick=\"tab('web',this)\">Interfaces Web</button></div>"
"<section class='panel'><div class='toolbar' style='margin-bottom:13px'><input id='pq' class='search' placeholder='Buscar payload...' oninput='render()'><select id='sort' onchange='render()'><option value='name'>Ordenar: nome</option><option value='size'>Ordenar: tamanho</option></select><button class='ghost' onclick='loadAll()'>↻ Atualizar</button><span id='ps' class='muted'></span></div><div id='msg'></div><div id='body' class='cards'></div></section>"
"<script>let P=[],S=[],W=[],T='all',rel={};const E=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));const F=n=>{let u=['B','KB','MB','GB'],i=0;n=Number(n)||0;while(n>=1024&&i<3){n/=1024;i++}return n.toFixed(i?1:0)+' '+u[i]};function note(t,b=false){msg.innerHTML=t?`<div class='notice ${b?'bad':'good'}' style='margin-bottom:12px'>${t}</div>`:''}function tab(t,e){T=t;document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('on',x===e));render()}function gh(u){let m=u.match(/github\\.com\\/([^/]+)\\/([^/#?]+)/i);return m?`https://api.github.com/repos/${m[1]}/${m[2].replace(/\\.git$/,'')}/releases/latest`:null}async function release(s){let api=gh(s.url);if(!api)return null;try{let r=await fetch(api,{cache:'no-store'});if(!r.ok)return null;let j=await r.json();return{tag:j.tag_name||j.name||'?',url:j.html_url||s.url,assets:j.assets||[]}}catch(e){return null}}async function loadAll(){let [p,s,w]=await Promise.all([fetch('/api/payloads',{cache:'no-store'}).then(r=>r.json()),fetch('/api/payload-sources',{cache:'no-store'}).then(r=>r.json()),fetch('/api/webapps',{cache:'no-store'}).then(r=>r.json())]);P=p.items||[];S=s.items||[];W=w.items||[];ps.textContent=(p.loader_port?'Loader '+p.loader_port+' pronto':'Loader offline')+' · '+P.length+' ELF';await Promise.all(S.map(async x=>rel[x.index]=await release(x)));render()}function localVer(n){let m=n.match(/(?:^|[-_.])v?(\\d+(?:\\.\\d+)+(?:[-._a-z0-9]*)?)/i);return m?m[1]:''}function srcFor(n){n=n.toLowerCase();return S.find(s=>n.includes((s.pattern||'').toLowerCase()))}function webFor(n){n=n.toLowerCase();return W.find(w=>w.online&&n.includes((w.hint||'').toLowerCase()))}function render(){body.className=(T==='sources'||T==='web')?'':'cards';if(T==='sources')return renderSources();if(T==='web')return renderWeb();body.className='cards';let q=pq.value.toLowerCase(),a=P.filter(x=>(T!=='run'||x.running)&&(T!=='fav'||x.favorite)&&(!q||x.name.toLowerCase().includes(q)));a.sort((x,y)=>sort.value==='size'?y.size-x.size:x.name.localeCompare(y.name));body.innerHTML=a.map(x=>{let s=srcFor(x.name),r=s?rel[s.index]:null,w=webFor(x.name),lv=localVer(x.name);return`<article class='card ${x.running?'run':''}'><button class='star ${x.favorite?'on':''}' onclick='fav(${JSON.stringify(x.name)})'>★</button><h3>⚡ ${E(x.name)}</h3><div class='meta'>${F(x.size)}${lv?' · local '+E(lv):''}${r?' · upstream '+E(r.tag):''}</div><div class='row'><span class='badge'>Baixado</span>${x.running?`<span class='badge run'>Em execução · PID ${x.pid||'?'}</span>`:''}${s?`<a class='badge blue' target='_blank' href='${E(s.url)}'>${E(s.name)}</a>`:''}</div><div class='row'>${x.running?`<button class='danger sm' onclick='stopP(${JSON.stringify(x.name)})'>⊗ Parar</button>`:`<button class='primary sm' onclick='launch(${JSON.stringify(x.path)})'>▷ Executar</button>`}${w?`<a class='btn green sm' href='${w.route}'>Abrir Web</a>`:''}<button class='ghost sm' onclick='linkSource(${JSON.stringify(x.name)})'>Fonte</button></div></article>`}).join('')||`<div class='notice'>Nenhum payload nessa seleção.</div>`}function renderSources(){body.innerHTML=`<div class='toolbar' style='margin-bottom:12px'><button class='primary' onclick='addSource()'>＋ Adicionar repositório por URL</button></div>`+S.map(s=>{let r=rel[s.index];return`<article class='panel' style='margin-bottom:9px'><div class='head' style='margin:0'><div><b>${E(s.name)}</b><div class='muted'>Padrão local: ${E(s.pattern)}<br>${E(s.url)}</div></div><div class='toolbar'>${r?`<span class='badge blue'>Última ${E(r.tag)}</span>`:`<span class='badge'>Versão não consultada</span>`}<a class='btn sm' target='_blank' href='${E(s.url)}'>Abrir fonte</a><button class='danger sm' onclick='delSource(${s.index})'>Remover</button></div></div></article>`}).join('')}function renderWeb(){body.innerHTML=`<div class='toolbar' style='margin-bottom:12px'><button class='primary' onclick='addWeb()'>＋ Registrar interface Web</button></div>`+W.map(w=>`<article class='panel' style='margin-bottom:9px'><div class='head' style='margin:0'><div><b>${E(w.label)}</b><div class='muted'>${E(w.hint)} · porta interna ${w.port}</div></div><div class='toolbar'><span class='status ${w.online?'on':''}'>${w.online?'ONLINE':'OFFLINE'}</span>${w.online?`<a class='btn green sm' href='${w.route}'>Abrir no Astro</a>`:''}</div></div></article>`).join('')}async function launch(p){note('Enviando ELF...');let r=await fetch('/api/payloads/launch?path='+encodeURIComponent(p),{method:'POST'});note(r.ok?'Payload enviado.':'Falha ao executar.',!r.ok);setTimeout(loadAll,800)}async function stopP(n){await fetch('/api/payloads/stop?name='+encodeURIComponent(n),{method:'POST'});loadAll()}async function fav(n){await fetch('/api/payloads/favorite?name='+encodeURIComponent(n),{method:'POST'});loadAll()}async function addSource(pref=''){let url=prompt('URL do repositório GitHub/Gitea:',pref);if(!url)return;let bits=url.replace(/\\/$/,'').split('/'),name=prompt('Nome da fonte:',bits[bits.length-1]||'Fonte');if(!name)return;let pat=prompt('Texto que identifica o ELF local:',bits[bits.length-1]||name);if(!pat)return;await fetch(`/api/payload-sources/add?name=${encodeURIComponent(name)}&url=${encodeURIComponent(url)}&pattern=${encodeURIComponent(pat)}`,{method:'POST'});loadAll()}function linkSource(n){addSource('')}async function delSource(i){if(confirm('Remover esta fonte?')){await fetch('/api/payload-sources/delete?index='+i,{method:'POST'});loadAll()}}async function addWeb(){let label=prompt('Nome da interface Web:');if(!label)return;let port=prompt('Porta interna do payload:');if(!port)return;let hint=prompt('Texto do nome/processo para associar:',label.toLowerCase().replace(/[^a-z0-9]+/g,''));if(!hint)return;let slug=label.toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');await fetch(`/api/webapps/add?slug=${encodeURIComponent(slug)}&label=${encodeURIComponent(label)}&port=${encodeURIComponent(port)}&hint=${encodeURIComponent(hint)}`,{method:'POST'});loadAll()}up.onchange=()=>{let f=up.files[0];if(!f)return;let x=new XMLHttpRequest();x.open('POST','/api/payloads/upload?name='+encodeURIComponent(f.name));x.upload.onprogress=e=>{if(e.lengthComputable)note('Upload '+Math.round(e.loaded*100/e.total)+'%')};x.onload=()=>{note(x.status===200?'ELF enviado.':'Falha no upload.',x.status!==200);loadAll()};x.send(f)};loadAll()</script>";strncat(page,b,sizeof(page)-strlen(page)-1);v3_page_end(page,sizeof(page));send_text(fd,"200 OK","text/html; charset=utf-8",NULL,page);
