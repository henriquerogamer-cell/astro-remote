"<div class='head'><div><h1>Homebrew</h1><p>Biblioteca do HB-Store/PKG-Zone incorporada ao Astro, com filtro, capas, versão e suporte PS5.</p></div><button onclick='loadHB()'>↻ Atualizar</button></div><section class='panel'><div class='tabs'><button class='tab on' data-c='all' onclick=\"cat('all',this)\">Todos</button><button class='tab' onclick=\"cat('utility',this)\">Utilitários</button><button class='tab' onclick=\"cat('game',this)\">HB Games</button><button class='tab' onclick=\"cat('emulator',this)\">Emuladores</button><button class='tab' onclick=\"cat('media',this)\">Multimídia</button></div><div class='toolbar' style='margin-bottom:13px'><input id='hq' class='search' placeholder='Buscar homebrew...' onkeydown=\"if(event.key==='Enter')loadHB(1)\"><select id='ho' onchange='loadHB(1)'><option value='created_at'>Mais recentes</option><option value='downloads'>Populares</option><option value=''>A-Z</option></select><button onclick='loadHB(1)'>Buscar</button><span id='hs' class='muted'>Pronto.</span></div><div id='hg' class='storegrid'></div><div class='row' style='justify-content:center;margin-top:15px'><button id='prev' onclick='loadHB(PAGE-1)'>← Anterior</button><span id='pg' class='muted'></span><button id='next' onclick='loadHB(PAGE+1)'>Próxima →</button></div></section>"
"<script>let CAT='all',PAGE=1,LAST=1;const ROOT='https://api.pkg-zone.com/';const E=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));function cat(c,e){CAT=c;document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('on',x===e));loadHB(1)}function norm(x){let d=x.data||x;return{id:x.cusa||x.id||d.cusa||d.id||'',name:x.name||d.name||x.title||'Homebrew',version:d.version||x.version||'',author:d.author||x.author||'',type:d.type||d.apptype||x.type||'',image:d.image||x.image||'',desc:Array.isArray(d.description)?d.description.join(' '):(d.description||d.desc||x.desc||''),ps5:d.file_ps5||x.file_ps5||'',url:x.url||d.url||x.package||d.package||''}}async function loadHB(p=PAGE){if(p<1)return;PAGE=p;hs.textContent='Carregando biblioteca...';hg.innerHTML='';let url=ROOT+'pkg/all?per_page=48&page='+PAGE+'&search='+encodeURIComponent(hq.value||'')+'&category='+encodeURIComponent(CAT)+'&orderBy='+encodeURIComponent(ho.value);try{let r=await fetch(url,{cache:'no-store'});if(!r.ok)throw new Error('HTTP '+r.status);let j=await r.json(),box=j.items||j,data=box.data||box.items||j.data||j.packages||[];LAST=box.last_page||box.lastPage||Math.max(1,Math.ceil((box.total||data.length)/48));let a=data.map(norm);hs.textContent=a.length+' itens · PKG-Zone';hg.innerHTML=a.map(x=>`<article class='pkg'><div class='pkgimg' style='background-image:url(${JSON.stringify(x.image)})'></div><div class='pkgb'><h3>${E(x.name)}</h3><div class='meta'>${E(x.author)}${x.version?' · v'+E(x.version):''}</div><div class='row'><span class='badge blue'>${E(x.type||'Homebrew')}</span>${x.ps5?`<span class='badge run'>PS5</span>`:''}</div><p class='muted'>${E(x.desc).slice(0,180)}</p><div class='row'>${x.ps5?`<a class='btn primary sm' target='_blank' rel='noopener' href='${E(x.ps5)}'>Baixar PS5</a>`:''}${x.url?`<a class='btn ghost sm' target='_blank' rel='noopener' href='${E(x.url)}'>Detalhes</a>`:''}</div></div></article>`).join('')||`<div class='notice'>Nenhum item encontrado.</div>`;pg.textContent='Página '+PAGE+' de '+LAST;prev.disabled=PAGE<=1;next.disabled=PAGE>=LAST}catch(e){hs.textContent='Falha ao consultar a biblioteca';hg.innerHTML=`<div class='notice bad'>A API do PKG-Zone não respondeu ao navegador (${E(e.message)}). O Astro não fica travado: tente Atualizar. Se o site exigir verificação anti-bot, ela precisa ser concluída no navegador.</div>`;pg.textContent='';}}loadHB(1)</script>";strncat(page,b,sizeof(page)-strlen(page)-1);v3_page_end(page,sizeof(page));send_text(fd,"200 OK","text/html; charset=utf-8",NULL,page);
}

