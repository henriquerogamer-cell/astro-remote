/* Astro V3 runtime-aware dashboard.
 * Running payloads are the union of Astro's local ELF library and actual
 * .elf processes on the PS5, so payloads launched by another loader still
 * get cards and Web UI access when detected.
 */

static void v3_dashboard(int fd)
{
  char page[104000];
  v3_page_start(page,sizeof(page),"Painel","dashboard");
  const char *b=
"<style>"
".dashHero{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px}.dashMetric{background:#121a25;border:1px solid #263548;border-radius:12px;padding:14px}.dashMetric .metric{font-size:25px;margin:8px 0 4px}.dashSection{background:#121a25;border:1px solid #263548;border-radius:12px;overflow:hidden;margin-bottom:14px}.dashSectionHead{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 15px;border-bottom:1px solid #263548}.dashSectionHead b{font-size:13px}.dashSectionBody{padding:14px}.payloadGrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:12px}.payloadCard{background:#111923;border:1px solid #29394c;border-radius:11px;padding:13px;min-height:164px;display:flex;flex-direction:column;transition:border-color .15s,transform .15s}.payloadCard:hover{border-color:#3b5674;transform:translateY(-1px)}.payloadCard.running{border-color:#216043}.payloadTop{display:flex;gap:12px;align-items:flex-start}.payloadIcon{width:46px;height:46px;border-radius:8px;border:1px solid #28598d;background:#132945;display:grid;place-items:center;color:#3d9cff;font-size:25px;flex:0 0 auto}.payloadInfo{min-width:0;flex:1}.payloadName{font-size:14px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px}.payloadMeta{font-size:10px;color:#8ea0b6;margin-top:6px}.webGlobe{width:31px;height:31px;border-radius:50%;display:grid;place-items:center;border:1px solid #28634f;background:#12392d;color:#78e0ba;font-size:15px;flex:0 0 auto}.payloadTags{display:flex;gap:6px;flex-wrap:wrap;margin-top:12px}.pill{display:inline-flex;align-items:center;gap:5px;border-radius:999px;padding:5px 9px;background:#253345;color:#9fb2c8;font-size:9px;font-weight:800}.pill.run{background:#123a2c;color:#52d49c}.pill.web{background:#12392d;color:#78e0ba}.pill.runtime{background:#2d253f;color:#c9a8ff}.payloadBottom{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:auto;padding-top:13px}.payloadBottom .left{display:flex;gap:6px;flex-wrap:wrap}.stopBtn{background:#2a1418!important;border-color:#70323a!important;color:#ff6d79!important}.webBtn{background:#12392d!important;border-color:#28634f!important;color:#78e0ba!important;font-weight:850!important}.empty{padding:28px;text-align:center;color:#8496ab}.quick{display:flex;gap:8px;flex-wrap:wrap}.quick .btn{min-width:110px;text-align:center}@media(max-width:900px){.dashHero{grid-template-columns:1fr 1fr}.payloadGrid{grid-template-columns:1fr}}@media(max-width:560px){.dashHero{grid-template-columns:1fr}}"
"</style>"
"<div class='head'><div><h1>Painel</h1><p>Estado do PS5 e acesso direto aos payloads realmente em execução.</p></div><button onclick='loadDash(true)'>↻ Atualizar</button></div>"
"<section class='dashHero'><article class='dashMetric'><div class='kicker'>ELF LOADER</div><div id='dloader' class='metric'>...</div><div id='dloadst' class='status'>consultando</div></article><article class='dashMetric'><div class='kicker'>PAYLOADS EM EXECUÇÃO</div><div id='drun' class='metric'>...</div><p class='muted'>Biblioteca + processos do PS5.</p></article><article class='dashMetric'><div class='kicker'>SAVES</div><div id='dsaves' class='metric'>...</div><p id='dusers' class='muted'>...</p></article><article class='dashMetric'><div class='kicker'>ARMAZENAMENTO</div><div id='dfree' class='metric'>...</div><p class='muted'>Livre em /data.</p></article></section>"
"<section class='dashSection'><div class='dashSectionHead'><b>Payloads em execução</b><div><span id='runCount' class='badge run'>...</span> <a class='btn ghost sm' href='/payloads'>Abrir biblioteca</a></div></div><div class='dashSectionBody'><div id='dplist' class='payloadGrid'></div></div></section>"
"<section class='panel'><div class='kicker'>ATALHOS</div><div class='quick' style='margin-top:11px'><a class='btn primary' href='/payloads'>Payloads</a><a class='btn' href='/files'>Arquivos</a><a class='btn' href='/saves'>Saves</a><a class='btn' href='/homebrew'>Homebrew</a></div></section>"
"<script>"
"const F=n=>{if(!n)return'0 B';let u=['B','KB','MB','GB','TB'],i=0;n=Number(n)||0;while(n>=1024&&i<4){n/=1024;i++}return n.toFixed(i?1:0)+' '+u[i]};"
"const E=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));"
"const elf=n=>/\\.elf$/i.test(String(n||''))&&!/^astro_remote\\.elf$/i.test(String(n||''));"
"function norm(n){return String(n||'').toLowerCase()}"
"function webFor(x,W){let n=norm(x.name),pid=Number(x.pid)||0;return W.find(w=>w.online&&((w.payload&&norm(w.payload)===n)||(pid&&Number(w.pid)===pid)||(w.hint&&n.includes(norm(w.hint)))))}"
"function mergeRuntime(lib,procs){let run=(lib||[]).filter(x=>x.running).map(x=>({...x,external:false})),pids=new Set(run.map(x=>Number(x.pid)||0).filter(Boolean)),names=new Set(run.map(x=>norm(x.name)));for(let p of(procs||[])){if(!elf(p.comm))continue;let pid=Number(p.pid)||0,n=norm(p.comm);if((pid&&pids.has(pid))||names.has(n))continue;run.push({name:p.comm,pid,ppid:p.ppid,uid:p.uid,rss:p.rss||0,size:0,running:true,external:true});if(pid)pids.add(pid);names.add(n)}return run}"
"async function stopDash(n){if(!confirm('Parar '+n+'?'))return;let r=await fetch('/api/payloads/stop?name='+encodeURIComponent(n),{method:'POST'});if(!r.ok)alert('Não foi possível parar '+n);setTimeout(()=>loadDash(true),350)}"
"async function loadDash(force){try{const [p,pr,s,u,w,st]=await Promise.all([fetch('/api/payloads',{cache:'no-store'}).then(x=>x.json()),fetch('/api/processes',{cache:'no-store'}).then(x=>x.json()),fetch('/api/saves',{cache:'no-store'}).then(x=>x.json()),fetch('/api/users',{cache:'no-store'}).then(x=>x.json()),fetch('/api/webapps'+(force?'?scan=1':''),{cache:'no-store'}).then(x=>x.json()),fetch('/api/storage',{cache:'no-store'}).then(x=>x.json())]);let W=w.items||[],run=mergeRuntime(p.items||[],pr.items||[]);drun.textContent=run.length;runCount.textContent=run.length+' em execução';dloader.textContent=p.loader_port?'PRONTO':'OFFLINE';dloadst.textContent=p.loader_port?'Loader interno '+p.loader_port:'loader indisponível';dloadst.className='status '+(p.loader_port?'on':'');dsaves.textContent=(s.items||[]).length;dusers.textContent=(u.users||[]).length+' usuário(s) encontrado(s)';dfree.textContent=F(st.data?.free||0);dplist.innerHTML=run.length?run.map(x=>{let ww=webFor(x,W),meta=x.external?`PID ${x.pid||'?'} · RAM ${F(x.rss||0)}`:`PID ${x.pid||'?'} · ${F(x.size||0)}`;return `<article class='payloadCard running'><div class='payloadTop'><div class='payloadIcon'>ϟ</div><div class='payloadInfo'><div class='payloadName'>${E(x.name)}</div><div class='payloadMeta'>${meta}</div></div>${ww?`<div class='webGlobe' title='Interface Web detectada'>🌐</div>`:''}</div><div class='payloadTags'>${x.external?`<span class='pill runtime'>Detectado no PS5</span>`:`<span class='pill'>Baixado</span>`}<span class='pill run'>● Em execução</span>${ww?`<span class='pill web'>Web disponível</span>`:''}</div><div class='payloadBottom'><div class='left'>${ww?`<a class='btn webBtn sm' href='${E(ww.route)}'>🌐 Acessar</a>`:''}</div><button class='stopBtn sm' onclick='stopDash(${JSON.stringify(x.name)})'>⊗ Parar</button></div></article>`}).join(''):`<div class='empty'>Nenhum payload ELF está rodando.</div>`}catch(e){dplist.innerHTML=`<div class='notice bad'>Falha ao atualizar o painel: ${E(e.message||e)}</div>`}}loadDash(false);"
"</script>";
  strncat(page,b,sizeof(page)-strlen(page)-1);
  v3_page_end(page,sizeof(page));
  send_text(fd,"200 OK","text/html; charset=utf-8",NULL,page);
}
