"<script>let SV=[],US=[],UF='all';const E=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));function note(t,b=false){document.getElementById('gstate').innerHTML=`<div class='notice ${b?'bad':'good'}' style='margin-bottom:12px'>${t}</div>`}async function loadSaves(){try{const [ur,sr]=await Promise.all([fetch('/p/garlic/api/users',{cache:'no-store'}),fetch('/p/garlic/api/saves',{cache:'no-store'})]);if(!ur.ok||!sr.ok)throw 0;US=(await ur.json()).users||[];SV=(await sr.json()).saves||[];note('Garlic conectado. '+SV.length+' saves encontrados.');renderTabs();renderSaves()}catch(e){note(`Garlic está offline. Inicie <b>garlic-savemgr.elf</b> em Payloads e volte aqui. <a class='btn sm' href='/payloads'>Abrir Payloads</a>`,true);document.getElementById('saves').innerHTML=''}}function renderTabs(){const e=document.getElementById('utabs');e.innerHTML=`<button class='tab ${UF==='all'?'active':''}' onclick=\"uf('all')\">Todos</button>`;for(const u of US)e.innerHTML+=`<button class='tab ${UF===u.id?'active':''}' onclick='uf(${JSON.stringify(u.id)})'>${E(u.name)}</button>`}function uf(x){UF=x;renderTabs();renderSaves()}function uname(id){return US.find(u=>u.id===id)?.name||('User '+id)}function renderSaves(){const q=document.getElementById('sq').value.toLowerCase(),e=document.getElementById('saves');e.innerHTML='';let a=SV.filter(x=>(UF==='all'||x.uid===UF)&&(!q||(x.title_name||'').toLowerCase().includes(q)||(x.title_id||'').toLowerCase().includes(q)));a.forEach((x,i)=>{const real=SV.indexOf(x),d=document.createElement('div');d.className='savecard';d.innerHTML=`<div class='saveicon'>${x.type==='PS4'?'4':'5'}</div><div class='saveinfo'><b>${E(x.title_name||x.title_id)}</b><span>${E(x.title_id)} · ${E(x.save_name)} · ${E(uname(x.uid))}</span></div><span class='badge ps5'>${E(x.type||'PS5')}</span><div class='actions'><button class='sm' onclick='backup(${real})'>Back up now</button><a class='btn sm primary' href='/p/garlic/api/download_raw?idx=${real}'>Download</a><button class='sm green' onclick='cloneSave(${real})'>Clonar para...</button></div>`;e.appendChild(d)});if(!a.length)e.innerHTML=`<div class='notice'>Nenhum save nesta seleção.</div>`}async function backup(i){const x=SV[i];note('Criando backup de '+E(x.title_name||x.title_id)+'...');try{const r=await fetch('/api/saves/backup?path='+encodeURIComponent(x.path)+'&uid='+encodeURIComponent(x.uid)+'&title='+encodeURIComponent(x.title_id),{method:'POST'}),j=await r.json();if(!j.ok)throw 0;note('Backup salvo no Astro: '+E(j.path))}catch(e){note('Falha ao criar backup.',true)}}async function cloneSave(i){const x=SV[i];if((x.type||'').toUpperCase()==='PS4'){note('Clone PS4 ainda fica pelo Garlic avançado nesta build.',true);return}let opts=US.filter(u=>u.id!==x.uid);if(!opts.length){note('Não existe outro usuário disponível.',true);return}const names=opts.map((u,n)=>(n+1)+' - '+u.name+' ['+u.id+']').join('\\n'),v=prompt('Destino do save:\\n'+names+'\\n\\nDigite o número:','1');if(!v)return;const u=opts[Number(v)-1];if(!u)return;if(!confirm('Clonar '+(x.title_name||x.title_id)+' de '+uname(x.uid)+' para '+u.name+'?'))return;note('Garlic está resignando e importando o save para '+E(u.name)+'...');try{const r=await fetch('/api/saves/clone?path='+encodeURIComponent(x.path)+'&uid='+encodeURIComponent(u.id),{method:'POST'}),j=await r.json();if(!j.ok)throw new Error(j.stage||j.error||'falha');note('Save clonado para '+E(u.name)+'.');await loadSaves()}catch(e){note('Clone falhou: '+E(e.message)+'. Abra Garlic avançado para ver detalhes.',true)}}loadSaves();</script>";
  strncat(page,body,sizeof(page)-strlen(page)-1);page_end(page,sizeof(page));send_text(fd,"200 OK","text/html; charset=utf-8",NULL,page);
}

