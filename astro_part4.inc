static void send_payloads_page(int fd)
{
  char page[52000];page_start(page,sizeof(page),"Payloads","payloads");
  const char *body=
"<div class='pagehead'><div><h1>Payloads</h1><p>Gerenciador nativo do Astro usando a mesma pasta de payloads do Prospero.</p></div><div class='toolbar'><input id='pup' type='file' accept='.elf,.bin' hidden onchange='uploadPayload(this)'><button onclick=\"document.getElementById('pup').click()\">Upload ELF</button><button class='ghost' onclick='loadPayloads()'>Atualizar</button></div></div>"
"<section class='panel'><div class='toolbar' style='margin-bottom:14px'><input id='pq' class='search' placeholder='Buscar payloads...' oninput='renderPayloads()'><div class='tabs'><button class='tab active' id='ptAll' onclick=\"setPTab('all')\">Todos</button><button class='tab' id='ptFav' onclick=\"setPTab('fav')\">Favoritos</button></div><span id='ploader' class='muted'></span></div><div id='pmsg'></div><div id='payloadCards' class='cards'></div></section>"
"<script>let P=[],pTab='all';const E=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));const F=n=>{if(!n)return'0 B';let u=['B','KB','MB','GB'],i=0;while(n>=1024&&i<u.length-1){n/=1024;i++}return n.toFixed(i?1:0)+' '+u[i]};function msg(t,b=false){document.getElementById('pmsg').innerHTML=t?`<div class='notice ${b?'bad':'good'}' style='margin-bottom:12px'>${E(t)}</div>`:''}function setPTab(t){pTab=t;document.getElementById('ptAll').classList.toggle('active',t==='all');document.getElementById('ptFav').classList.toggle('active',t==='fav');renderPayloads()}async function loadPayloads(){try{const r=await fetch('/api/payloads/list',{cache:'no-store'}),j=await r.json();P=j.items||[];document.getElementById('ploader').textContent=j.loader_port?'Loader '+j.loader_port+' pronto':'Loader 9020/9021 offline';renderPayloads()}catch(e){msg('Falha ao ler payloads: '+e,true)}}function renderPayloads(){const q=document.getElementById('pq').value.toLowerCase(),el=document.getElementById('payloadCards');el.innerHTML='';let a=P.filter(x=>(pTab!=='fav'||x.favorite)&&(!q||x.name.toLowerCase().includes(q)));for(const x of a){const d=document.createElement('article');d.className='pcard';d.innerHTML=`<button class='star ${x.favorite?'on':''}' title='Favorito' onclick='fav(${JSON.stringify(x.name)})'>★</button><div class='pname'>⚡ ${E(x.name)}</div><div class='pmeta'>${F(x.size)}</div><div style='margin-top:12px'><span class='badge'>Downloaded</span></div><div class='actions' style='margin-top:18px'><button class='primary sm' onclick='launchPayload(${JSON.stringify(x.path)})'>▷ Launch</button><a class='btn ghost sm' href='/files?path=${encodeURIComponent(x.path.replace(/\\/[^/]+$/,''))}'>Pasta</a></div>`;el.appendChild(d)}if(!a.length)el.innerHTML=`<div class='notice'>Nenhum payload encontrado em /data/ProsperoMgr/payloads.</div>`}async function launchPayload(path){msg('Enviando payload ao ELF loader...');try{const r=await fetch('/api/payloads/launch?path='+encodeURIComponent(path),{method:'POST'}),j=await r.json();if(!j.ok)throw new Error('loader indisponível (rc '+j.rc+')');msg('Payload enviado pela porta '+j.port)}catch(e){msg('Não foi possível iniciar: '+e.message,true)}}async function fav(name){await fetch('/api/payloads/favorite?name='+encodeURIComponent(name),{method:'POST'});await loadPayloads()}function uploadPayload(inp){const f=inp.files[0];if(!f)return;const x=new XMLHttpRequest();x.open('POST','/api/files/upload?path='+encodeURIComponent('/data/ProsperoMgr/payloads/'+f.name));x.upload.onprogress=e=>{if(e.lengthComputable)msg('Upload '+Math.round(e.loaded*100/e.total)+'%')};x.onload=()=>{msg(x.status===200?'Upload concluído':'Falha no upload',x.status!==200);loadPayloads()};x.send(f)}loadPayloads();</script>";
  strncat(page,body,sizeof(page)-strlen(page)-1);page_end(page,sizeof(page));send_text(fd,"200 OK","text/html; charset=utf-8",NULL,page);
}

static void send_file_list_api(int fd,const char *target)
{
  char path[2048]="/data";query_value(target,"path",path,sizeof(path));if(!mgr_safe_path(path)){send_text(fd,"400 Bad Request","application/json",NULL,"{\"ok\":false,\"error\":\"path\"}");return;}DIR *d=opendir(path);if(!d){send_text(fd,"404 Not Found","application/json",NULL,"{\"ok\":false,\"error\":\"open\"}");return;}size_t cap=768*1024,used=0;char *j=malloc(cap);if(!j){closedir(d);send_text(fd,"500 Internal Server Error","application/json",NULL,"{\"ok\":false}");return;}char ep[4096];json_escape(path,ep,sizeof(ep));used+=(size_t)snprintf(j+used,cap-used,"{\"ok\":true,\"path\":\"%s\",\"items\":[",ep);struct dirent *e;int first=1,count=0;while((e=readdir(d))&&count<1200){if(!strcmp(e->d_name,".")||!strcmp(e->d_name,".."))continue;char full[4096];snprintf(full,sizeof(full),"%s/%s",path,e->d_name);struct stat st;if(lstat(full,&st)!=0)continue;char en[2048];json_escape(e->d_name,en,sizeof(en));int n=snprintf(j+used,cap-used,"%s{\"name\":\"%s\",\"dir\":%s,\"size\":%llu,\"mtime\":%lld,\"mode\":\"%04o\"}",first?"":",",en,S_ISDIR(st.st_mode)?"true":"false",(unsigned long long)st.st_size,(long long)st.st_mtime,(unsigned)(st.st_mode&07777));if(n<0||used+(size_t)n+64>=cap)break;used+=(size_t)n;first=0;count++;}closedir(d);snprintf(j+used,cap-used,"]}");send_text(fd,"200 OK","application/json; charset=utf-8",NULL,j);free(j);
}

static void send_download(int fd,const char *target)
{
  char path[2048];if(!query_value(target,"path",path,sizeof(path))||!mgr_safe_path(path)){send_text(fd,"400 Bad Request","text/plain",NULL,"Caminho invalido");return;}struct stat st;if(stat(path,&st)!=0||!S_ISREG(st.st_mode)){send_text(fd,"404 Not Found","text/plain",NULL,"Arquivo nao encontrado");return;}FILE *f=fopen(path,"rb");if(!f){send_text(fd,"403 Forbidden","text/plain",NULL,"Sem acesso");return;}const char *base=strrchr(path,'/');base=base?base+1:path;char safe[512];size_t k=0;for(size_t i=0;base[i]&&k+1<sizeof(safe);++i){char c=base[i];safe[k++]=(c=='\"'||c=='\r'||c=='\n')?'_':c;}safe[k]=0;char h[1200];snprintf(h,sizeof(h),"HTTP/1.1 200 OK\r\nContent-Type: application/octet-stream\r\nContent-Length: %llu\r\nContent-Disposition: attachment; filename=\"%s\"\r\nConnection: close\r\n\r\n",(unsigned long long)st.st_size,safe);send_all(fd,h,strlen(h));char b[256*1024];size_t n;while((n=fread(b,1,sizeof(b),f))>0)if(send_all(fd,b,n)!=0)break;fclose(f);
}

static void send_files_page(int fd)
{
  char page[62000];page_start(page,sizeof(page),"Arquivos","files");
  const char *body=
"<div class='pagehead'><div><h1>Arquivos</h1><p>Gerenciador nativo com operações de arquivo direto no PS5.</p></div><div class='toolbar'><input id='fu' type='file' multiple hidden onchange='uploadFiles(this.files)'><input id='fud' type='file' webkitdirectory multiple hidden onchange='uploadFolder(this.files)'><button onclick=\"newFile()\">＋ Arquivo</button><button onclick=\"newFolder()\">📁 Pasta</button><button class='primary' onclick=\"document.getElementById('fu').click()\">⇧ Upload</button><button onclick=\"document.getElementById('fud').click()\">Upload pasta</button></div></div>"
"<div class='storage'><div class='storagebox'><div class='label'>Internal data</div><div id='sd' class='nums'>Lendo...</div><div class='barline'><div id='sdb' class='barfill'></div></div></div><div class='storagebox'><div class='label'>User storage</div><div id='su' class='nums'>Lendo...</div><div class='barline'><div id='sub' class='barfill'></div></div></div></div>"
"<section class='panel'><div class='pathbar'><button onclick='upDir()'>↑</button><input id='path' value='/data'><button onclick='loadDir()'>Abrir</button></div><div class='toolbar' style='margin-bottom:12px'><input id='fq' class='search' placeholder='Buscar nesta pasta...' oninput='renderFiles()'><select id='fsort' onchange='renderFiles()'><option value='name'>Nome</option><option value='size'>Tamanho</option><option value='date'>Modificado</option></select><button class='ghost' onclick='loadDir()'>↻</button><span id='fprog' class='muted'></span></div><div class='tablewrap'><table><thead><tr><th>Nome</th><th>Tamanho</th><th>Modificado</th><th>Permissões</th><th>Ações</th></tr></thead><tbody id='rows'></tbody></table></div></section>"
"<script>let FI=[],CP='/data';const E=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));const F=n=>{if(!n)return'0 B';let u=['B','KB','MB','GB','TB'],i=0;while(n>=1024&&i<u.length-1){n/=1024;i++}return n.toFixed(i?1:0)+' '+u[i]};const join=(a,b)=>(a.replace(/\\/$/,'')+'/'+b);async function storage(){try{const j=await(await fetch('/api/storage')).json();for(const k of ['data','user']){const x=j[k],used=x.total-x.free,p=x.total?Math.round(used*100/x.total):0;document.getElementById(k==='data'?'sd':'su').textContent=F(x.free)+' livres de '+F(x.total);document.getElementById(k==='data'?'sdb':'sub').style.width=p+'%'}}catch(e){}}async function loadDir(p){p=p||document.getElementById('path').value;try{const j=await(await fetch('/api/files/list?path='+encodeURIComponent(p),{cache:'no-store'})).json();if(!j.ok)throw 0;CP=j.path;FI=j.items||[];document.getElementById('path').value=CP;renderFiles()}catch(e){alert('Não foi possível abrir '+p)}}function renderFiles(){const q=document.getElementById('fq').value.toLowerCase(),s=document.getElementById('fsort').value;let a=FI.filter(x=>!q||x.name.toLowerCase().includes(q));a.sort((x,y)=>{if(x.dir!==y.dir)return x.dir?-1:1;if(s==='size')return y.size-x.size;if(s==='date')return y.mtime-x.mtime;return x.name.localeCompare(y.name)});const r=document.getElementById('rows');r.innerHTML='';for(const x of a){const p=join(CP,x.name),tr=document.createElement('tr');tr.innerHTML=`<td class='name'>${x.dir?`<span class='filelink' onclick='loadDir(${JSON.stringify(p)})'>📁 ${E(x.name)}</span>`:`📄 ${E(x.name)}`}</td><td>${x.dir?'—':F(x.size)}</td><td>${new Date(x.mtime*1000).toLocaleString()}</td><td><code>${E(x.mode)}</code></td><td><div class='actions'>${x.dir?'':`<a class='btn sm ghost' href='/api/files/download?path=${encodeURIComponent(p)}'>Baixar</a>`}<button class='sm' onclick='ren(${JSON.stringify(p)},${JSON.stringify(x.name)})'>Renomear</button><button class='sm' onclick='cp(${JSON.stringify(p)},false)'>Copiar</button><button class='sm' onclick='cp(${JSON.stringify(p)},true)'>Mover</button><button class='sm red' onclick='del(${JSON.stringify(p)})'>Excluir</button></div></td>`;r.appendChild(tr)}}function upDir(){if(CP==='/')return;loadDir(CP.replace(/\\/+$/,'').replace(/\\/[^/]+$/,'')||'/')}async function post(url){const r=await fetch(url,{method:'POST'});if(!r.ok)throw new Error(await r.text());return r}async function newFolder(){const n=prompt('Nome da pasta:');if(!n)return;await post('/api/files/mkdir?path='+encodeURIComponent(join(CP,n)));loadDir()}async function newFile(){const n=prompt('Nome do arquivo:');if(!n)return;await post('/api/files/touch?path='+encodeURIComponent(join(CP,n)));loadDir()}async function ren(p,n){const v=prompt('Novo nome:',n);if(!v||v===n)return;await post('/api/files/rename?path='+encodeURIComponent(p)+'&name='+encodeURIComponent(v));loadDir()}async function del(p){if(!confirm('Excluir '+p+'?'))return;await post('/api/files/delete?path='+encodeURIComponent(p));loadDir()}async function cp(src,mv){const d=prompt((mv?'Mover':'Copiar')+' para qual caminho completo?',src);if(!d||d===src)return;await post('/api/files/'+(mv?'move':'copy')+'?src='+encodeURIComponent(src)+'&dst='+encodeURIComponent(d));loadDir()}function sendOne(f,dst){return new Promise((ok,no)=>{const x=new XMLHttpRequest();x.open('POST','/api/files/upload?path='+encodeURIComponent(dst));x.upload.onprogress=e=>{if(e.lengthComputable)document.getElementById('fprog').textContent=f.name+' '+Math.round(e.loaded*100/e.total)+'%'};x.onload=()=>x.status===200?ok():no();x.onerror=no;x.send(f)})}async function uploadFiles(fs){for(const f of fs)await sendOne(f,join(CP,f.name));document.getElementById('fprog').textContent='Upload concluído';loadDir();storage()}async function uploadFolder(fs){for(const f of fs){const rel=f.webkitRelativePath||f.name;await sendOne(f,join(CP,rel))}document.getElementById('fprog').textContent='Pasta enviada';loadDir();storage()}const qp=new URLSearchParams(location.search).get('path');loadDir(qp||'/data');storage();</script>";
  strncat(page,body,sizeof(page)-strlen(page)-1);page_end(page,sizeof(page));send_text(fd,"200 OK","text/html; charset=utf-8",NULL,page);
}

static void send_saves_page(int fd)
{
  char page[62000];page_start(page,sizeof(page),"Saves","saves");
  const char *body=
"<div class='pagehead'><div><h1>Saves</h1><p>Interface do Astro, motor Garlic. Backup normal fica no Astro; clone entre usuários usa o resign/import do Garlic.</p></div><div class='toolbar'><button class='ghost' onclick='loadSaves()'>↻ Atualizar</button><a class='btn ghost' href='/p/garlic/'>Garlic avançado</a></div></div>"
