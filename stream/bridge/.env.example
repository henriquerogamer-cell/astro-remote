# Interface fisica do host Linux ligada na mesma LAN do PS5.
ASTRO_STREAM_LAN_PARENT=enp3s0

# Ajuste para a rede local do PS5.
ASTRO_STREAM_LAN_SUBNET=192.168.0.0/24
ASTRO_STREAM_LAN_GATEWAY=192.168.0.1

# IP livre dentro da LAN. Este IP sera usado pelo backend para falar com o PS5.
ASTRO_STREAM_LAN_IP=192.168.0.50

# Portas HTTP expostas pelo host.
ASTRO_STREAM_WEB_PORT=10110
ASTRO_STREAM_API_PORT=10111

# Troque antes de expor o bridge fora da LAN.
ASTRO_STREAM_DB_PASSWORD=troque-esta-senha
ASTRO_STREAM_JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria

TZ=America/Sao_Paulo
