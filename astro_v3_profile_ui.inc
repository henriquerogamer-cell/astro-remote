    snprintf(uid,sizeof(uid),"--------"); snprintf(name,sizeof(name),"PS5");
  }
  char en[160]; json_escape(name,en,sizeof(en));
  char page[64000]; v3_page_start(page,sizeof(page),"Perfil","profile");
  char b[52000];
  snprintf(b,sizeof(b),
"<style>"
".profilecard{display:flex;align-items:center;gap:16px}.bigav{width:70px;height:70px;border-radius:50%%;object-fit:cover;background:#172231;border:2px solid #38506b}.profname{font-size:18px;font-weight:850}.profileline{display:flex;gap:10px;align-items:center;margin-top:7px}.dropavatar{min-height:290px;border:1px dashed #314359;border-radius:12px;background:#0b121a;display:grid;place-items:center;padding:18px;text-align:center}.avatarEditor{display:none;grid-template-columns:minmax(260px,440px) 1fr;gap:18px;align-items:start}.avatarEditor.show{display:grid}.previewWrap{position:relative;width:min(440px,100%%);aspect-ratio:1;border-radius:16px;overflow:hidden;background:#080c12;border:1px solid #2d4055;touch-action:none}.previewWrap canvas{width:100%%;height:100%%;display:block}.editControls .field{margin-bottom:14px}.editControls label{display:block;font-size:10px;color:var(--muted);margin-bottom:6px}.modeBtns{display:flex;gap:6px}.modeBtns button.on{background:#1b3553;border-color:#3475b8;color:#fff}.progressbar{height:7px;border-radius:999px;background:#15202c;overflow:hidden;margin-top:10px}.progressbar i{display:block;height:100%%;width:0;background:var(--blue);transition:width .18s}.currentAvatarFallback{width:70px;height:70px;border-radius:50%%;display:grid;place-items:center;background:#172231;color:#85b9fa;font-size:25px;font-weight:900}.profilePanelHead{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:13px}.profilePanelHead h2{font-size:14px;margin:0}.cropHint{font-size:10px;color:#60758e;margin-top:7px}.filebtn{display:inline-flex;align-items:center;gap:7px}.filebtn input{display:none}@media(max-width:850px){.avatarEditor.show{grid-template-columns:1fr}.profilecard{align-items:flex-start}}"
"</style>"
"<div class='head'><div><h1>Perfil</h1><p>Usuário ativo do PS5, nome e avatar administrados direto pelo Astro.</p></div></div>"
"<section class='grid'>"
"<article class='panel full'><div class='profilePanelHead'><h2>Perfil atual</h2><button class='ghost sm' onclick='refreshCurrentAvatar()'>↻ Atualizar</button></div><div class='profilecard'>"
"<img id='currentAvatar' class='bigav' src='/api/profile/avatar?t=%lld' onerror=\"this.style.display='none';document.getElementById('currentFallback').style.display='grid'\">"
"<div id='currentFallback' class='currentAvatarFallback' style='display:none'>%c</div>"
"<div><div class='profname'>%s</div><div class='profileline'><span class='status on'>Conectado</span><span class='muted'>0x%s</span></div><div class='muted' style='margin-top:8px'>O ID online do PS5 aceita até 16 caracteres.</div></div></div></article>"
"<article class='panel c6'><div class='kicker'>NOME DE EXIBIÇÃO</div><p class='muted'>O Astro cria uma cópia de segurança antes de alterar o nome.</p><div class='row'><input id='pn' value='%s' maxlength='16' style='flex:1'><button class='primary' onclick='saveName()'>Salvar nome</button></div><div id='nameMsg' class='muted' style='margin-top:8px'></div></article>"
"<article class='panel c6'><div class='kicker'>AVATAR ATUAL</div><p class='muted'>O Astro procura avatar.png e picture.png no cache real do usuário ativo.</p><div class='row'><a class='btn ghost' href='/api/profile/avatar' target='_blank'>Abrir imagem atual</a></div></article>"
"<article class='panel full'><div class='profilePanelHead'><div><h2>Alterar avatar</h2><div class='muted'>PNG ou JPG. O navegador prepara os quatro tamanhos usados pelo cache do PS5: 64, 128, 260 e 440.</div></div><label class='btn primary filebtn'>⇧ Escolher imagem<input id='avatarFile' type='file' accept='image/png,image/jpeg'></label></div>"
"<div id='dropAvatar' class='dropavatar'><div><div style='font-size:34px;color:#4e94e8;margin-bottom:10px'>◎</div><b>Solte uma imagem aqui ou escolha um arquivo</b><p class='muted'>Depois você pode enquadrar, dar zoom e conferir a prévia antes de aplicar.</p></div></div>"
"<div id='avatarEditor' class='avatarEditor'><div><div id='previewWrap' class='previewWrap'><canvas id='avatarCanvas' width='440' height='440'></canvas></div><div class='cropHint'>Arraste a imagem para reposicionar. O quadro acima é exatamente a versão 440×440.</div></div>"
"<div class='editControls'><div class='field'><label>ENQUADRAMENTO</label><div class='modeBtns'><button id='cropBtn' class='on' onclick=\"setMode('crop')\">Preencher / cortar</button><button id='fitBtn' onclick=\"setMode('fit')\">Encaixar</button></div></div>"
"<div class='field'><label>ZOOM <span id='zoomLabel'>100%%</span></label><input id='zoomRange' type='range' min='100' max='300' value='100' style='width:100%%'></div>"
"<div class='row'><button class='ghost' onclick='resetFrame()'>Redefinir enquadramento</button><button id='applyAvatar' class='primary' onclick='applyAvatar()'>Aplicar avatar no PS5</button></div>"
"<div id='avatarMsg' class='notice' style='margin-top:14px'>Escolha uma imagem para começar.</div><div class='progressbar'><i id='avatarProgress'></i></div>"
"<p class='muted' style='margin-top:12px'>Antes da gravação o Astro salva os arquivos atuais em <code>/data/Astro/profile-backup</code>. O menu do PS5 pode manter a imagem antiga em memória até recarregar a sessão.</p></div></div></article></section>"
"<script>"
"const $=id=>document.getElementById(id);let srcImg=null,mode='crop',zoom=1,panX=0,panY=0,drag=false,lastX=0,lastY=0;"
"function esc(s){return String(s??'').replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\"'\":'&#39;'}[c]))}"
"async function saveName(){const n=$('pn').value.trim();if(!n)return;try{const r=await fetch('/api/profile/name?name='+encodeURIComponent(n),{method:'POST'}),j=await r.json();$('nameMsg').textContent=j.ok?'Nome gravado. Recarregue a sessão do PS5 se o shell mantiver o nome anterior.':'Falha ao alterar o nome.'}catch(e){$('nameMsg').textContent='Falha ao alterar o nome.'}}"
"function refreshCurrentAvatar(){$('currentAvatar').style.display='block';$('currentFallback').style.display='none';$('currentAvatar').src='/api/profile/avatar?t='+Date.now()}"
"function msg(t,bad=false){const e=$('avatarMsg');e.className='notice '+(bad?'bad':'good');e.textContent=t}function prog(p){$('avatarProgress').style.width=Math.max(0,Math.min(100,p))+'%%'}"
"function setMode(m){mode=m;$('cropBtn').classList.toggle('on',m==='crop');$('fitBtn').classList.toggle('on',m==='fit');panX=panY=0;draw()}"
"function resetFrame(){zoom=1;panX=panY=0;$('zoomRange').value=100;$('zoomLabel').textContent='100%%';draw()}"
"function loadFile(f){if(!f||!f.type.match(/^image\\/(png|jpeg)$/)){msg('Use uma imagem PNG ou JPG.',true);return}const u=URL.createObjectURL(f),im=new Image();im.onload=()=>{srcImg=im;URL.revokeObjectURL(u);resetFrame();$('dropAvatar').style.display='none';$('avatarEditor').classList.add('show');msg('Imagem carregada. Ajuste o enquadramento e aplique quando estiver pronto.');};im.onerror=()=>{URL.revokeObjectURL(u);msg('Não consegui abrir essa imagem.',true)};im.src=u}"
"$('avatarFile').addEventListener('change',e=>loadFile(e.target.files[0]));const dz=$('dropAvatar');['dragenter','dragover'].forEach(x=>dz.addEventListener(x,e=>{e.preventDefault();dz.style.borderColor='#4387cb'}));['dragleave','drop'].forEach(x=>dz.addEventListener(x,e=>{e.preventDefault();dz.style.borderColor=''}));dz.addEventListener('drop',e=>loadFile(e.dataTransfer.files[0]));dz.addEventListener('click',()=>$('avatarFile').click());"
"$('zoomRange').addEventListener('input',e=>{zoom=Number(e.target.value)/100;$('zoomLabel').textContent=e.target.value+'%%';draw()});const wrap=$('previewWrap');wrap.addEventListener('pointerdown',e=>{if(!srcImg)return;drag=true;lastX=e.clientX;lastY=e.clientY;wrap.setPointerCapture(e.pointerId)});wrap.addEventListener('pointermove',e=>{if(!drag)return;const r=wrap.getBoundingClientRect(),s=440/r.width;panX+=(e.clientX-lastX)*s;panY+=(e.clientY-lastY)*s;lastX=e.clientX;lastY=e.clientY;draw()});wrap.addEventListener('pointerup',()=>drag=false);wrap.addEventListener('pointercancel',()=>drag=false);"
"function drawTo(ctx,w,h){ctx.clearRect(0,0,w,h);if(!srcImg)return;const base=(mode==='crop'?Math.max(w/srcImg.width,h/srcImg.height):Math.min(w/srcImg.width,h/srcImg.height));const sc=base*zoom,dw=srcImg.width*sc,dh=srcImg.height*sc;const px=panX*(w/440),py=panY*(h/440);ctx.drawImage(srcImg,(w-dw)/2+px,(h-dh)/2+py,dw,dh)}function draw(){const c=$('avatarCanvas');drawTo(c.getContext('2d'),440,440)}"
"function c565(r,g,b){return ((r>>3)<<11)|((g>>2)<<5)|(b>>3)}function c888(v){return [((v>>11)&31)<<3,((v>>5)&63)<<2,(v&31)<<3]}function dist(a,b){const r=a[0]-b[0],g=a[1]-b[1],q=a[2]-b[2];return r*r+g*g+q*q}"
"function blockDXT5(p){const o=new Uint8Array(16);let amin=255,amax=0;for(let i=0;i<16;i++){const a=p[i*4+3];if(a<amin)amin=a;if(a>amax)amax=a}o[0]=amax;o[1]=amin;const ap=new Array(8);ap[0]=amax;ap[1]=amin;if(amax>amin){for(let i=0;i<6;i++)ap[i+2]=Math.round(((6-i)*amax+(i+1)*amin)/7)}else{for(let i=0;i<4;i++)ap[i+2]=Math.round(((4-i)*amax+(i+1)*amin)/5);ap[6]=0;ap[7]=255}let ai=0n;for(let i=0;i<16;i++){let bi=0,bd=999;for(let j=0;j<8;j++){const d=Math.abs(p[i*4+3]-ap[j]);if(d<bd){bd=d;bi=j}}ai|=BigInt(bi)<<(BigInt(i)*3n)}for(let i=0;i<6;i++)o[2+i]=Number((ai>>(BigInt(i)*8n))&255n);let mn=[255,255,255],mx=[0,0,0];for(let i=0;i<16;i++)for(let k=0;k<3;k++){const v=p[i*4+k];if(v<mn[k])mn[k]=v;if(v>mx[k])mx[k]=v}let c0=c565(...mx),c1=c565(...mn);if(c0<c1){const t=c0;c0=c1;c1=t}if(c0===c1)c0=Math.min(65535,c0+1);const a=c888(c0),b=c888(c1),pal=[a,b,[0,0,0],[0,0,0]];for(let k=0;k<3;k++){pal[2][k]=Math.round((2*a[k]+b[k])/3);pal[3][k]=Math.round((a[k]+2*b[k])/3)}let ci=0;for(let i=0;i<16;i++){const q=[p[i*4],p[i*4+1],p[i*4+2]];let bi=0,bd=dist(q,pal[0]);for(let j=1;j<4;j++){const d=dist(q,pal[j]);if(d<bd){bd=d;bi=j}}ci|=(bi<<(i*2))}o[8]=c0&255;o[9]=(c0>>8)&255;o[10]=c1&255;o[11]=(c1>>8)&255;o[12]=ci&255;o[13]=(ci>>>8)&255;o[14]=(ci>>>16)&255;o[15]=(ci>>>24)&255;return o}"
"function makeDDS(c){const w=c.width,h=c.height,bw=Math.ceil(w/4),bh=Math.ceil(h/4),out=new Uint8Array(128+bw*bh*16),v=new DataView(out.buffer);v.setUint32(0,0x20534444,true);v.setUint32(4,124,true);v.setUint32(8,0x00081007,true);v.setUint32(12,h,true);v.setUint32(16,w,true);v.setUint32(20,bw*bh*16,true);v.setUint32(76,32,true);v.setUint32(80,4,true);out[84]=68;out[85]=88;out[86]=84;out[87]=53;v.setUint32(108,0x1000,true);const d=c.getContext('2d').getImageData(0,0,w,h).data;let pos=128;for(let by=0;by<bh;by++)for(let bx=0;bx<bw;bx++){const p=new Uint8Array(64);for(let y=0;y<4;y++)for(let x=0;x<4;x++){const px=Math.min(w-1,bx*4+x),py=Math.min(h-1,by*4+y),si=(py*w+px)*4,di=(y*4+x)*4;p[di]=d[si];p[di+1]=d[si+1];p[di+2]=d[si+2];p[di+3]=d[si+3]}out.set(blockDXT5(p),pos);pos+=16}return new Blob([out],{type:'application/octet-stream'})}"
"function pngBlob(c){return new Promise((ok,no)=>c.toBlob(b=>b?ok(b):no(new Error('PNG')),'image/png'))}async function send(name,blob){const r=await fetch('/api/profile/avatar/upload?name='+encodeURIComponent(name),{method:'POST',body:blob});const j=await r.json();if(!r.ok||!j.ok)throw new Error(name+' rc '+(j.rc??'?'))}"
"async function applyAvatar(){if(!srcImg){msg('Escolha uma imagem primeiro.',true);return}const bt=$('applyAvatar');bt.disabled=true;prog(2);try{let r=await fetch('/api/profile/avatar/prepare',{method:'POST'}),j=await r.json();if(!r.ok||!j.ok)throw new Error('backup/prepare');msg('Backup criado. Gerando avatar...');const sizes=[64,128,260,440];let step=0;let png440=null;for(const sz of sizes){const c=document.createElement('canvas');c.width=c.height=sz;drawTo(c.getContext('2d'),sz,sz);const dds=makeDDS(c);await send('avatar'+sz+'.dds',dds);await send('picture'+sz+'.dds',dds);if(sz===440)png440=await pngBlob(c);step++;prog(10+step*18)}if(!png440){const c=document.createElement('canvas');c.width=c.height=440;drawTo(c.getContext('2d'),440,440);png440=await pngBlob(c)}await send('avatar.png',png440);prog(88);await send('picture.png',png440);prog(96);r=await fetch('/api/profile/avatar/finish',{method:'POST'});j=await r.json();if(!r.ok||!j.ok)throw new Error('finish');prog(100);msg('Avatar aplicado. A prévia do Astro já foi atualizada. Se o menu do PS5 continuar com a imagem antiga, recarregue a sessão.');refreshCurrentAvatar()}catch(e){msg('Falha ao aplicar avatar: '+e.message,true);prog(0)}finally{bt.disabled=false}}"
"</script>",
(long long)time(NULL), name[0]?toupper((unsigned char)name[0]):'A', en, uid, en);
  strncat(page,b,sizeof(page)-strlen(page)-1);
  v3_page_end(page,sizeof(page));
