/* Ordered, configurable Astro payload autoloader. */
#include <pthread.h>
#define ASTRO_AUTOLOAD_FILE ASTRO_DIR "/autoload.cfg"
#define ASTRO_AUTOLOAD_MAX 32
typedef struct { char name[256];int delay; } astro_auto_item_t;

static int astro_auto_valid(const char *n){size_t z=n?strlen(n):0;return z>4&&z<256&&!strchr(n,'/')&&!strchr(n,'\\')&&!strcasecmp(n+z-4,".elf");}
static int astro_auto_load(astro_auto_item_t *a){FILE *f=fopen(ASTRO_AUTOLOAD_FILE,"r");if(!f)return 0;int n=0;char line[600];while(n<ASTRO_AUTOLOAD_MAX&&fgets(line,sizeof(line),f)){line[strcspn(line,"\r\n")]=0;char *tab=strchr(line,'\t');if(!tab)continue;*tab++=0;int d=atoi(line);if(d<0||d>300||!astro_auto_valid(tab))continue;a[n].delay=d;snprintf(a[n++].name,sizeof(a[0].name),"%s",tab);}fclose(f);return n;}
static int astro_auto_save(astro_auto_item_t *a,int n){char tmp[512];snprintf(tmp,sizeof(tmp),"%s.tmp",ASTRO_AUTOLOAD_FILE);FILE *f=fopen(tmp,"w");if(!f)return -1;for(int i=0;i<n;i++)fprintf(f,"%d\t%s\n",a[i].delay,a[i].name);fflush(f);fsync(fileno(f));fclose(f);if(rename(tmp,ASTRO_AUTOLOAD_FILE)){unlink(tmp);return -1;}return 0;}
static void v3_autoload_api(int fd,const char *target,const char *method){
  astro_auto_item_t a[ASTRO_AUTOLOAD_MAX];int n=astro_auto_load(a);
  if(!strcmp(method,"POST")){char action[24]="add",name[256]={0},ds[24]={0},is[24]={0};query_value(target,"action",action,sizeof(action));query_value(target,"name",name,sizeof(name));query_value(target,"delay",ds,sizeof(ds));query_value(target,"index",is,sizeof(is));int idx=atoi(is),delay=atoi(ds);
    if(!strcmp(action,"add")){if(!astro_auto_valid(name)||delay<0||delay>300){send_text(fd,"400 Bad Request","application/json",NULL,"{\"ok\":false,\"error\":\"invalid\"}");return;}char path[1024];snprintf(path,sizeof(path),"%s/%s",ASTRO_PAYLOAD_DIR,name);struct stat st;if(stat(path,&st)||!S_ISREG(st.st_mode)){send_text(fd,"404 Not Found","application/json",NULL,"{\"ok\":false,\"error\":\"not_found\"}");return;}int found=-1;for(int i=0;i<n;i++)if(!strcmp(a[i].name,name))found=i;if(found>=0)a[found].delay=delay;else if(n<ASTRO_AUTOLOAD_MAX){snprintf(a[n].name,sizeof(a[n].name),"%s",name);a[n++].delay=delay;}else{send_text(fd,"409 Conflict","application/json",NULL,"{\"ok\":false,\"error\":\"full\"}");return;}}
    else if(!strcmp(action,"delete")){if(idx<0||idx>=n){send_text(fd,"400 Bad Request","application/json",NULL,"{\"ok\":false}");return;}for(int i=idx;i<n-1;i++)a[i]=a[i+1];n--;}
    else if(!strcmp(action,"move")){char ts[24];query_value(target,"to",ts,sizeof(ts));int to=atoi(ts);if(idx<0||idx>=n||to<0||to>=n){send_text(fd,"400 Bad Request","application/json",NULL,"{\"ok\":false}");return;}astro_auto_item_t x=a[idx];if(idx<to)for(int i=idx;i<to;i++)a[i]=a[i+1];else for(int i=idx;i>to;i--)a[i]=a[i-1];a[to]=x;}
    if(astro_auto_save(a,n)){send_text(fd,"500 Internal Server Error","application/json",NULL,"{\"ok\":false}");return;}send_text(fd,"200 OK","application/json",NULL,"{\"ok\":true}");return;}
  char j[32768];size_t u=0;u+=snprintf(j+u,sizeof(j)-u,"{\"ok\":true,\"items\":[");for(int i=0;i<n&&u+800<sizeof(j);i++){char e[600];json_escape(a[i].name,e,sizeof(e));u+=snprintf(j+u,sizeof(j)-u,"%s{\"index\":%d,\"name\":\"%s\",\"delay\":%d}",i?",":"",i,e,a[i].delay);}snprintf(j+u,sizeof(j)-u,"]}");send_text(fd,"200 OK","application/json; charset=utf-8",NULL,j);
}
static void *astro_autoload_worker(void *unused){(void)unused;for(int i=0;i<30&&!v3_loader_port();i++)sleep(1);if(!v3_loader_port()){notify("ASTRO autoload: ELF loader offline");return NULL;}astro_auto_item_t a[ASTRO_AUTOLOAD_MAX];int n=astro_auto_load(a),ok=0,fail=0;for(int i=0;i<n;i++){if(!v3_payload_pid(a[i].name)){char path[1024];snprintf(path,sizeof(path),"%s/%s",ASTRO_PAYLOAD_DIR,a[i].name);int port=0;if(v3_send_payload(path,&port)==0)ok++;else fail++;}if(i+1<n&&a[i].delay>0)sleep((unsigned)a[i].delay);}if(n){char msg[128];snprintf(msg,sizeof(msg),"ASTRO autoload: %d iniciado(s)%s",ok,fail?" · falha detectada":"");notify(msg);}return NULL;}
static void astro_autoload_start(void){pthread_t th;if(!pthread_create(&th,NULL,astro_autoload_worker,NULL))pthread_detach(th);}
