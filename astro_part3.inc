static const char *base_css =
"*{box-sizing:border-box}"
":root{--bg:#0b0f14;--panel:#111821;--panel2:#151e29;--line:#253242;--text:#e8edf4;--muted:#8292a6;--blue:#2f8cff;--blue2:#66aaff;--green:#36c98f;--red:#ef5e68;--gold:#d4b36d}"
"body{margin:0;min-height:100vh;background:#0b0f14;color:var(--text);font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Arial,sans-serif}a{color:inherit;text-decoration:none}"
".shell{width:min(1360px,calc(100% - 28px));margin:0 auto 50px}.top{height:64px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{font-size:16px;font-weight:900;letter-spacing:.18em}.brand small{display:block;font-size:9px;color:var(--muted);letter-spacing:.22em;margin-top:3px}.statuspill{font-size:11px;color:var(--green);border:1px solid #245541;padding:7px 11px;border-radius:999px}"
".nav{height:54px;display:flex;gap:4px;align-items:center;overflow-x:auto;border-bottom:1px solid var(--line);margin-bottom:22px}.nav a{white-space:nowrap;padding:9px 13px;border-radius:9px;color:#91a1b4;font-size:13px;font-weight:650}.nav a:hover,.nav a.active{background:#192536;color:#fff}.nav a.active{box-shadow:inset 3px 0 0 var(--blue)}"
".pagehead{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin:0 0 18px}.pagehead h1{font-size:25px;margin:0 0 5px}.pagehead p{margin:0;color:var(--muted);font-size:13px}.toolbar{display:flex;gap:9px;align-items:center;flex-wrap:wrap}"
".panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px}.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:14px}.col4{grid-column:span 4}.col6{grid-column:span 6}.col8{grid-column:span 8}.full{grid-column:1/-1}"
".module{min-height:145px;position:relative}.module h2{font-size:15px;margin:0 0 7px}.module p{font-size:12px;color:var(--muted);line-height:1.5;margin:0 0 15px}.kicker{font-size:10px;color:#6f8094;text-transform:uppercase;letter-spacing:.11em;margin-bottom:9px}.bigstat{font-size:25px;font-weight:850;margin:6px 0}.status{display:inline-flex;align-items:center;gap:6px;font-size:10px;font-weight:800;text-transform:uppercase}.status:before{content:'';width:7px;height:7px;border-radius:50%;background:#677483}.status.on{color:var(--green)}.status.on:before{background:var(--green)}.status.off{color:#748194}"
".btn,button{border:1px solid #36506a;background:#18283a;color:#f3f7fb;border-radius:9px;padding:9px 13px;font-weight:700;font-size:12px;cursor:pointer}.btn:hover,button:hover{background:#20354c}.btn.primary,button.primary{background:var(--blue);border-color:var(--blue);color:white}.btn.green{background:#123d30;border-color:#27664f;color:#75deb7}.btn.red,button.red{background:#33171b;border-color:#6e2f36;color:#ff9aa1}.btn.ghost{background:transparent;border-color:#2c3948;color:#aeb9c7}.btn.sm{padding:7px 10px;font-size:11px}"
"input,select{background:#0c1219;border:1px solid #2a394a;color:#e8edf4;border-radius:9px;padding:10px 11px;outline:none}input:focus,select:focus{border-color:#477fb7}.search{min-width:260px;flex:1}.field{margin:11px 0}.field label{display:block;font-size:10px;color:#8292a6;text-transform:uppercase;letter-spacing:.08em;margin-bottom:6px}"
".tabs{display:flex;gap:4px;border:1px solid var(--line);padding:3px;border-radius:10px;width:max-content}.tab{border:0;background:transparent;color:#8f9cad;padding:7px 12px;border-radius:7px;font-size:12px;cursor:pointer}.tab.active{background:var(--blue);color:white}"
".cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:12px}.pcard{background:#101720;border:1px solid #273444;border-radius:13px;padding:14px;min-height:145px}.pcard:hover{border-color:#3a526c}.pname{font-size:14px;font-weight:750;word-break:break-word}.pmeta{font-size:11px;color:#78899d;margin-top:5px}.badge{display:inline-block;border-radius:999px;padding:4px 8px;font-size:9px;font-weight:800;background:#243143;color:#9fb2c8;margin-right:5px}.badge.run{background:#133b2e;color:#55d9a5}.badge.ps5{background:#e9edf3;color:#17202b}.star{float:right;border:0;background:transparent;padding:2px;color:#6d7b8d;font-size:18px}.star.on{color:var(--gold)}"
".storage{display:grid;grid-template-columns:repeat(2,minmax(220px,1fr));gap:10px;margin-bottom:14px}.storagebox{background:#0d141d;border:1px solid #253344;border-radius:11px;padding:12px}.storagebox .label{font-size:12px;font-weight:750}.storagebox .nums{font-size:11px;color:#8292a6;margin-top:4px}.barline{height:5px;background:#202b38;border-radius:99px;margin-top:9px;overflow:hidden}.barfill{height:100%;background:var(--blue);width:0}"
".pathbar{display:flex;gap:8px;margin:12px 0}.pathbar input{flex:1}.tablewrap{overflow:auto;border:1px solid #243141;border-radius:11px}table{width:100%;border-collapse:collapse;font-size:12px}th,td{padding:11px 12px;border-bottom:1px solid #202c39;text-align:left;white-space:nowrap}th{color:#8392a5;font-weight:650;background:#0e151e;position:sticky;top:0}td.name{white-space:normal;min-width:260px}.filelink{color:#8ec0ff;cursor:pointer}.muted{color:var(--muted)}"
".savecard{display:flex;align-items:center;gap:13px;padding:13px;border:1px solid #283545;border-radius:12px;background:#101720;margin-bottom:9px}.saveicon{width:44px;height:44px;border-radius:9px;background:#192638;display:grid;place-items:center;font-weight:900;color:#7fb7ff}.saveinfo{flex:1;min-width:0}.saveinfo b{display:block;font-size:13px}.saveinfo span{font-size:11px;color:#8392a6}.actions{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}"
".storegrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(245px,1fr));gap:12px}.pkg{border:1px solid #283545;background:#101720;border-radius:13px;padding:14px}.pkg h3{margin:0 0 5px;font-size:14px}.pkg p{font-size:11px;color:#8392a6;min-height:34px}.pkg .ver{font-size:10px;color:#d9b86d}.notice{padding:11px 13px;border:1px solid #35465a;background:#101923;border-radius:10px;color:#95a7bb;font-size:12px}.notice.bad{border-color:#69343b;color:#ef9ba1;background:#241317}.notice.good{border-color:#285b48;color:#76d9b2;background:#11251e}"
".foot{text-align:center;color:#536274;font-size:10px;margin-top:24px}@media(max-width:850px){.col4,.col6,.col8{grid-column:1/-1}.storage{grid-template-columns:1fr}.pagehead{align-items:flex-start;flex-direction:column}.actions{justify-content:flex-start}.savecard{align-items:flex-start;flex-wrap:wrap}.nav{margin-left:-4px;margin-right:-4px}}";

static void page_start(char *out,size_t out_sz,const char *title,const char *active)
{
  snprintf(out,out_sz,
"<!doctype html><html lang='pt-BR'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>%s · Astro</title><style>%s</style></head><body><main class='shell'>"
"<header class='top'><div class='brand'>ASTRO<small>PS5 CONTROL DECK</small></div><div class='statuspill'>● PS5 ONLINE</div></header>"
"<nav class='nav'><a class='%s' href='/dashboard'>Painel</a><a class='%s' href='/payloads'>Payloads</a><a class='%s' href='/files'>Arquivos</a><a class='%s' href='/saves'>Saves</a><a class='%s' href='/homebrew'>Homebrew</a><a class='%s' href='/services'>Serviços</a><a class='%s' href='/settings'>Ajustes</a><a href='/logout'>Sair</a></nav>",
  title,base_css,
  !strcmp(active,"dashboard")?"active":"",!strcmp(active,"payloads")?"active":"",!strcmp(active,"files")?"active":"",!strcmp(active,"saves")?"active":"",!strcmp(active,"homebrew")?"active":"",!strcmp(active,"services")?"active":"",!strcmp(active,"settings")?"active":"");
}

static void page_end(char *out,size_t out_sz){strncat(out,"<div class='foot'>ASTRO v2 · payloads · arquivos · saves · homebrew</div></main></body></html>",out_sz-strlen(out)-1);}

static void send_setup(int fd,const char *error)
{
  char page[18000];snprintf(page,sizeof(page),
"<!doctype html><html lang='pt-BR'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Configurar Astro</title><style>%s .box{width:min(460px,calc(100%% - 28px));margin:8vh auto;background:#111821;border:1px solid #29394a;border-radius:16px;padding:26px}.box h1{margin:4px 0 6px}.err{color:#ffa2a9;background:#28171b;border:1px solid #69333a;padding:10px;border-radius:9px;font-size:12px}</style></head><body><section class='box'><div class='kicker'>PRIMEIRO ACESSO</div><h1>Crie o acesso do Astro</h1><p class='muted'>Esse usuário e senha serão os mesmos na rede local e no acesso remoto.</p>%s<form method='POST' action='/setup'><div class='field'><label>Usuário</label><input name='username' minlength='3' maxlength='47' required></div><div class='field'><label>Senha</label><input name='password' type='password' minlength='8' maxlength='95' required></div><div class='field'><label>Confirmar senha</label><input name='password2' type='password' minlength='8' maxlength='95' required></div><button class='primary' type='submit'>Criar acesso</button></form></section></body></html>",base_css,error?error:"");send_text(fd,"200 OK","text/html; charset=utf-8",NULL,page);
}

static void send_login(int fd,int bad)
{
  char page[16000];snprintf(page,sizeof(page),
"<!doctype html><html lang='pt-BR'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Astro</title><style>%s .box{width:min(430px,calc(100%% - 28px));margin:10vh auto;background:#111821;border:1px solid #29394a;border-radius:16px;padding:26px}.box h1{letter-spacing:.16em}.err{color:#ffa2a9;font-size:12px}</style></head><body><section class='box'><div class='kicker'>PS5 CONTROL DECK</div><h1>ASTRO</h1>%s<form method='POST' action='/login'><div class='field'><label>Usuário</label><input name='username' required></div><div class='field'><label>Senha</label><input name='password' type='password' required></div><button class='primary' type='submit'>Entrar</button></form></section></body></html>",base_css,bad?"<p class='err'>Usuário ou senha inválidos.</p>":"");send_text(fd,"200 OK","text/html; charset=utf-8",NULL,page);
}

static void send_dashboard(int fd)
{
  int p=port_open(PROSPERO_PORT),g=port_open(PEGASUS_PORT),s=port_open(GARLIC_PORT),lp=mgr_loader_port();char page[32000];page_start(page,sizeof(page),"Painel","dashboard");char b[22000];snprintf(b,sizeof(b),
"<div class='pagehead'><div><h1>Painel</h1><p>As funções principais agora são nativas do Astro. Prospero e Garlic ficam como motores auxiliares quando necessário.</p></div></div><section class='grid'>"
"<article class='panel module col4'><div class='kicker'>GERENCIADOR</div><h2>Payloads</h2><div class='bigstat'>%s</div><p>Biblioteca em /data/ProsperoMgr/payloads, upload, favoritos e execução.</p><a class='btn primary' href='/payloads'>Abrir payloads</a></article>"
"<article class='panel module col4'><div class='kicker'>GERENCIADOR</div><h2>Arquivos</h2><div class='bigstat'>Nativo</div><p>Upload, download, pastas, renomear, copiar, mover e excluir.</p><a class='btn primary' href='/files'>Abrir arquivos</a></article>"
"<article class='panel module col4'><div class='kicker'>GARLIC ENGINE</div><h2>Saves</h2><div class='status %s'>%s</div><p>Backup normal e clone entre usuários usando resign/import do Garlic.</p><a class='btn primary' href='/saves'>Abrir saves</a></article>"
"<article class='panel module col4'><div class='kicker'>CATÁLOGO</div><h2>Homebrew</h2><div class='bigstat'>PS5</div><p>Catálogo com fallback local, sem ficar preso eternamente em “Carregando”.</p><a class='btn primary' href='/homebrew'>Abrir catálogo</a></article>"
"<article class='panel module col4'><div class='kicker'>SERVIÇO</div><h2>Prospero</h2><div class='status %s'>%s</div><p>Continua disponível como ferramenta avançada e referência.</p><a class='btn ghost' href='/p/prospero/'>Abrir Prospero</a></article>"
"<article class='panel module col4'><div class='kicker'>SERVIÇO</div><h2>Pegasus DL</h2><div class='status %s'>%s</div><p>Abre por dentro do Astro quando estiver rodando.</p><a class='btn ghost' href='/p/pegasus/'>Abrir Pegasus</a></article></section>",lp?"Loader pronto":"Loader offline",s?"on":"off",s?"ONLINE":"OFFLINE",p?"on":"off",p?"ONLINE":"OFFLINE",g?"on":"off",g?"ONLINE":"OFFLINE");strncat(page,b,sizeof(page)-strlen(page)-1);page_end(page,sizeof(page));send_text(fd,"200 OK","text/html; charset=utf-8",NULL,page);
}

static void send_services(int fd)
{
  int p=port_open(PROSPERO_PORT),g=port_open(PEGASUS_PORT),s=port_open(GARLIC_PORT);char page[24000];page_start(page,sizeof(page),"Serviços","services");char b[16000];snprintf(b,sizeof(b),
"<div class='pagehead'><div><h1>Serviços</h1><p>Ferramentas web auxiliares acessadas pela sessão autenticada do Astro.</p></div></div><section class='panel'>"
"<div class='savecard'><div class='saveicon'>P</div><div class='saveinfo'><b>Prospero Manager</b><span>127.0.0.1:%d</span></div><div class='status %s'>%s</div><a class='btn sm' href='/p/prospero/'>Abrir</a></div>"
"<div class='savecard'><div class='saveicon'>D</div><div class='saveinfo'><b>Pegasus DL</b><span>127.0.0.1:%d</span></div><div class='status %s'>%s</div><a class='btn sm' href='/p/pegasus/'>Abrir</a></div>"
"<div class='savecard'><div class='saveicon'>G</div><div class='saveinfo'><b>Garlic SaveMgr</b><span>127.0.0.1:%d</span></div><div class='status %s'>%s</div><a class='btn sm' href='/p/garlic/'>Abrir</a></div></section>",PROSPERO_PORT,p?"on":"off",p?"ONLINE":"OFFLINE",PEGASUS_PORT,g?"on":"off",g?"ONLINE":"OFFLINE",GARLIC_PORT,s?"on":"off",s?"ONLINE":"OFFLINE");strncat(page,b,sizeof(page)-strlen(page)-1);page_end(page,sizeof(page));send_text(fd,"200 OK","text/html; charset=utf-8",NULL,page);
}
