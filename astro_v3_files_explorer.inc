/* Astro V3 Explorer-style file manager.
 * Lazy folder tree on the left, current directory on the right.
 */

static void v3_files_page(int fd)
{
  char page[128000];
  v3_page_start(page,sizeof(page),"Arquivos","files");
  const char *b=
"<style>"
".explorer{display:grid;grid-template-columns:285px minmax(0,1fr);min-height:620px;background:#0d141d;border:1px solid #263548;border-radius:13px;overflow:hidden}.treePane{border-right:1px solid #263548;background:#0b121a;min-width:0}.treeHead{height:48px;padding:0 14px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #223044}.treeTitle{font-size:11px;font-weight:850;color:#b9c7d7}.treeScroll{padding:9px 7px 18px;overflow:auto;max-height:650px}.treeGroup{margin:7px 7px 4px;color:#5f738b;font-size:8px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.tn{display:flex;align-items:center;gap:5px;height:30px;padding:0 7px;border-radius:7px;color:#94a5b8;font-size:11px;cursor:pointer;white-space:nowrap;user-select:none}.tn:hover{background:#142132;color:#dfe9f5}.tn.sel{background:#17304c;color:#fff}.tw{width:15px;text-align:center;color:#5f738a;font-size:10px;flex:0 0 auto}.tw.blank{opacity:0}.ti{width:18px;text-align:center;flex:0 0 auto}.tl{overflow:hidden;text-overflow:ellipsis}.treeChildren{margin-left:17px;border-left:1px solid #1f2d3d;padding-left:3px}.treeLoading{padding:6px 10px 6px 28px;color:#5d7188;font-size:9px}.filePane{min-width:0;background:#111923}.explorerBar{display:flex;gap:7px;align-items:center;padding:10px 11px;border-bottom:1px solid #263548;background:#101821}.navbtn{width:34px;height:34px;padding:0;display:grid;place-items:center}.address{flex:1;min-width:140px;height:34px}.crumbs{display:flex;gap:3px;align-items:center;padding:9px 12px;border-bottom:1px solid #202d3c;overflow-x:auto;white-space:nowrap}.crumb{border:0!important;background:transparent!important;color:#7faee6!important;padding:3px 5px!important;font-size:10px!important}.crumb:hover{color:#dbeaff!important}.sep{color:#44566b;font-size:10px}.fileTools{display:flex;gap:7px;align-items:center;flex-wrap:wrap;padding:10px 11px;border-bottom:1px solid #263548}.fileTools .search{min-width:180px}.fileStatus{margin-left:auto;color:#6d8097;font-size:9px}.fileTable{overflow:auto;max-height:510px}.fileTable table{border:0;border-radius:0}.fileTable tbody tr{transition:background .1s}.fileTable tbody tr:hover{background:#14202d}.ficon{display:inline-grid;place-items:center;width:21px;margin-right:4px}.fopen{color:#c7d9ec;cursor:pointer}.fopen:hover{color:#77b9ff}.emptyDir{padding:55px 20px;text-align:center;color:#63778e}.dropOn{outline:2px dashed #2d8cff;outline-offset:-7px;background:#102039}.treeDisk{margin:9px 9px 4px;padding:10px;border-radius:9px;border:1px solid #223246;background:#0e1721}.treeDisk b{display:block;font-size:10px}.treeDisk span{display:block;font-size:9px;color:#6d8198;margin-top:4px}.miniBar{height:4px;background:#202d3b;border-radius:99px;overflow:hidden;margin-top:7px}.miniBar i{display:block;height:100%;background:#2d8cff;width:0}.mobileTree{display:none}"
"@media(max-width:860px){.explorer{grid-template-columns:1fr}.treePane{display:none;border-right:0;border-bottom:1px solid #263548}.treePane.show{display:block}.treeScroll{max-height:300px}.mobileTree{display:inline-flex}.fileTable{max-height:none}.fileStatus{width:100%;margin-left:0}.explorer{min-height:0}}"
"</style>"
"<div class='head'><div><h1>Arquivos</h1><p>Explore o armazenamento do PS5 com árvore de pastas, upload e operações diretas.</p></div><div class='toolbar'><input id='fu' type='file' multiple hidden><button onclick='newFolder()'>＋ Pasta</button><button class='primary' onclick='fu.click()'>⇧ Upload</button></div></div>"
"<section class='explorer' id='explorer'><aside class='treePane' id='treePane'><div class='treeHead'><div class='treeTitle'>Este PS5</div><button class='ghost sm' onclick='refreshTree()'>↻</button></div><div class='treeDisk'><b>Internal data</b><span id='td'>...</span><div class='miniBar'><i id='tdb'></i></div></div><div class='treeDisk'><b>User storage</b><span id='tu'>...</span><div class='miniBar'><i id='tub'></i></div></div><div class='treeScroll'><div class='treeGroup'>Armazenamento</div><div id='treeMain'></div><div class='treeGroup' id='deviceLabel' style='display:none'>Dispositivos</div><div id='treeDevices'></div></div></aside>"
"<main class='filePane' id='filePane'><div class='explorerBar'><button class='navbtn mobileTree' onclick=\"treePane.classList.toggle('show')\">☰</button><button id='backBtn' class='navbtn' onclick='goBack()' title='Voltar'>←</button><button id='fwdBtn' class='navbtn' onclick='goForward()' title='Avançar'>→</button><button class='navbtn' onclick='upDir()' title='Pasta acima'>↑</button><input id='path' class='address' value='/data' onkeydown=\"if(event.key==='Enter')loadDir(path.value)\"><button onclick='loadDir(path.value)'>Abrir</button><button class='ghost navbtn' onclick='reloadDir()' title='Atualizar'>↻</button></div><div id='crumbs' class='crumbs'></div><div class='fileTools'><input id='fq' class='search' placeholder='Buscar nesta pasta...' oninput='renderF()'><select id='fsort' onchange='renderF()'><option value='name'>Nome</option><option value='date'>Modificado</option><option value='size'>Tamanho</option></select><span id='prog' class='muted'></span><span id='fileStatus' class='fileStatus'></span></div><div class='fileTable'><table><thead><tr><th>Nome</th><th>Tamanho</th><th>Modificado</th><th>Perm.</th><th>Ações</th></tr></thead><tbody id='rows'></tbody></table></div></main></section>"
"<script>"
"let FI=[],CP='/data',H=[],HI=-1,treeData=new Map(),treeOpen=new Set(['/data']),treeSel='/data',devices=[];"
"const F=n=>{let u=['B','KB','MB','GB','TB'],i=0;n=Number(n)||0;while(n>=1024&&i<4){n/=1024;i++}return n.toFixed(i?1:0)+' '+u[i]};"
"const E=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));"
"const J=(a,b)=>a.replace(/\\/$/,'')+'/'+b;"
"function pname(p){return p.split('/').filter(Boolean).pop()||'/'}"
"async function apiDir(p){let r=await fetch('/api/files?path='+encodeURIComponent(p),{cache:'no-store'});if(!r.ok)return null;let j=await r.json();return j.ok?j:null}"
"async function storage(){try{let j=await fetch('/api/storage',{cache:'no-store'}).then(r=>r.json());for(const k of ['data','user']){let x=j[k];if(!x)continue,used=x.total-x.free,p=x.total?Math.round(used*100/x.total):0;document.getElementById(k==='data'?'td':'tu').textContent=F(x.free)+' livres de '+F(x.total);document.getElementById(k==='data'?'tdb':'tub').style.width=p+'%' }}catch(e){}}"
"function rootFor(p){if(p==='/data'||p.startsWith('/data/'))return'/data';if(p==='/user'||p.startsWith('/user/'))return'/user';for(let d of devices)if(p===d||p.startsWith(d+'/'))return d;return null}"
"async function treeChildren(p,force=false){if(treeData.has(p)&&!force)return treeData.get(p);let j=await apiDir(p);let a=j?(j.items||[]).filter(x=>x.dir).sort((a,b)=>a.name.localeCompare(b.name)).map(x=>({name:x.name,path:J(p,x.name)})):[];treeData.set(p,a);return a}"
"function treeNode(n,depth=0){let open=treeOpen.has(n.path),loaded=treeData.has(n.path),kids=treeData.get(n.path)||[],sel=treeSel===n.path;return `<div><div class='tn ${sel?'sel':''}' title='${E(n.path)}' onclick='selectTree(${JSON.stringify(n.path)})'><span class='tw' onclick='event.stopPropagation();toggleTree(${JSON.stringify(n.path)})'>${open?'▾':'▸'}</span><span class='ti'>📁</span><span class='tl'>${E(n.name)}</span></div>${open?`<div class='treeChildren'>${loaded?(kids.length?kids.map(x=>treeNode(x,depth+1)).join(''):`<div class='treeLoading'>Sem subpastas</div>`):`<div class='treeLoading'>Carregando...</div>`}</div>`:''}</div>`}"
"function renderTree(){treeMain.innerHTML=treeNode({name:'Internal data',path:'/data'})+treeNode({name:'User storage',path:'/user'});treeDevices.innerHTML=devices.map(p=>treeNode({name:p.replace('/mnt/',''),path:p})).join('');deviceLabel.style.display=devices.length?'block':'none'}"
"async function toggleTree(p){if(treeOpen.has(p)){treeOpen.delete(p);renderTree();return}treeOpen.add(p);renderTree();await treeChildren(p);renderTree()}"
"async function selectTree(p){treeSel=p;if(!treeData.has(p))treeChildren(p);renderTree();await loadDir(p);if(innerWidth<861)treePane.classList.remove('show')}"
"async function syncTree(p){let root=rootFor(p);if(!root)return;let parts=p.slice(root.length).split('/').filter(Boolean),cur=root;treeOpen.add(root);for(let part of parts){await treeChildren(cur);cur=J(cur,part);treeOpen.add(cur)}treeSel=p;renderTree()}"
"async function probeDevices(){let cand=['/mnt/usb0','/mnt/usb1','/mnt/ext0','/mnt/ext1','/mnt/sandbox'];let ok=[];for(let p of cand){let j=await apiDir(p);if(j){ok.push(p);treeData.set(p,(j.items||[]).filter(x=>x.dir).sort((a,b)=>a.name.localeCompare(b.name)).map(x=>({name:x.name,path:J(p,x.name)})))}}devices=ok;renderTree()}"
"async function refreshTree(){treeData.clear();treeOpen=new Set([rootFor(CP)||'/data']);await treeChildren(rootFor(CP)||'/data',true);await probeDevices();await syncTree(CP)}"
"function historyPush(p){if(H[HI]===p)return;H=H.slice(0,HI+1);H.push(p);HI=H.length-1;histBtns()}function histBtns(){backBtn.disabled=HI<=0;fwdBtn.disabled=HI<0||HI>=H.length-1}"
"async function goBack(){if(HI<=0)return;HI--;await loadDir(H[HI],false);histBtns()}async function goForward(){if(HI>=H.length-1)return;HI++;await loadDir(H[HI],false);histBtns()}"
"async function loadDir(p,push=true){p=p||path.value;let j=await apiDir(p);if(!j)return alert('Não foi possível abrir '+p);CP=j.path;FI=j.items||[];path.value=CP;if(push)historyPush(CP);renderCrumbs();renderF();syncTree(CP)}"
"function reloadDir(){loadDir(CP,false);treeData.delete(CP);treeChildren(CP,true).then(renderTree)}"
"function renderCrumbs(){let root=rootFor(CP),html='';if(!root){crumbs.innerHTML='';return}let seg=root.split('/').filter(Boolean),cur='';for(let i=0;i<seg.length;i++){cur+='/'+seg[i];html+=(i?`<span class='sep'>›</span>`:'')+`<button class='crumb' onclick='loadDir(${JSON.stringify(cur)})'>${E(seg[i])}</button>`}let rest=CP.slice(root.length).split('/').filter(Boolean);cur=root;for(let s of rest){cur=J(cur,s);html+=`<span class='sep'>›</span><button class='crumb' onclick='loadDir(${JSON.stringify(cur)})'>${E(s)}</button>`}crumbs.innerHTML=html}"
"function renderF(){let q=fq.value.toLowerCase(),a=FI.filter(x=>!q||x.name.toLowerCase().includes(q));a.sort((x,y)=>{if(x.dir!==y.dir)return x.dir?-1:1;if(fsort.value==='date')return (y.mtime||0)-(x.mtime||0);if(fsort.value==='size')return (y.size||0)-(x.size||0);return x.name.localeCompare(y.name)});fileStatus.textContent=a.length+' item(ns)';rows.innerHTML=a.length?a.map(x=>{let p=J(CP,x.name);return `<tr><td class='fname'>${x.dir?`<span class='fopen' onclick='loadDir(${JSON.stringify(p)})'><span class='ficon'>📁</span>${E(x.name)}</span>`:`<span><span class='ficon'>📄</span>${E(x.name)}</span>`}</td><td>${x.dir?'—':F(x.size)}</td><td>${new Date(x.mtime*1000).toLocaleString()}</td><td>${E(x.mode||'')}</td><td><div class='toolbar'>${x.dir?'':`<a class='btn sm ghost' href='/api/files/download?path=${encodeURIComponent(p)}'>Baixar</a>`}<button class='sm' onclick='ren(${JSON.stringify(p)},${JSON.stringify(x.name)})'>Renomear</button><button class='danger sm' onclick='del(${JSON.stringify(p)})'>Excluir</button></div></td></tr>`}).join(''):`<tr><td colspan='5'><div class='emptyDir'>Esta pasta está vazia.</div></td></tr>`}"
"function upDir(){let r=rootFor(CP);if(!r||CP===r)return;loadDir(CP.replace(/\\/+$/,'').replace(/\\/[^/]+$/,'')||r)}"
"async function post(u){let r=await fetch(u,{method:'POST'});if(!r.ok)throw new Error('Falha na operação')}"
"async function newFolder(){let n=prompt('Nome da pasta:');if(!n)return;try{await post('/api/files/mkdir?path='+encodeURIComponent(J(CP,n)));treeData.delete(CP);await loadDir(CP,false);await treeChildren(CP,true);renderTree()}catch(e){alert(e.message)}}"
"async function ren(p,n){let v=prompt('Novo nome:',n);if(!v||v===n)return;try{await post('/api/files/rename?path='+encodeURIComponent(p)+'&name='+encodeURIComponent(v));treeData.delete(CP);await loadDir(CP,false);await treeChildren(CP,true);renderTree()}catch(e){alert(e.message)}}"
"async function del(p){if(!confirm('Excluir '+p+'?'))return;try{await post('/api/files/delete?path='+encodeURIComponent(p));treeData.delete(CP);await loadDir(CP,false);await treeChildren(CP,true);renderTree()}catch(e){alert(e.message)}}"
"function send(f){return new Promise((ok,no)=>{let x=new XMLHttpRequest();x.open('POST','/api/files/upload?path='+encodeURIComponent(J(CP,f.name)));x.upload.onprogress=e=>{if(e.lengthComputable)prog.textContent=f.name+' · '+Math.round(e.loaded*100/e.total)+'%'};x.onload=()=>x.status===200?ok():no(new Error('Falha no upload de '+f.name));x.onerror=()=>no(new Error('Falha no upload de '+f.name));x.send(f)})}"
"async function uploadFiles(list){for(const f of list)try{await send(f)}catch(e){alert(e.message);break}prog.textContent='Upload concluído';await loadDir(CP,false);storage()}"
"fu.onchange=()=>uploadFiles(fu.files);filePane.ondragover=e=>{e.preventDefault();filePane.classList.add('dropOn')};filePane.ondragleave=()=>filePane.classList.remove('dropOn');filePane.ondrop=e=>{e.preventDefault();filePane.classList.remove('dropOn');if(e.dataTransfer.files.length)uploadFiles(e.dataTransfer.files)};"
"async function init(){renderTree();await Promise.all([storage(),treeChildren('/data'),treeChildren('/user')]);renderTree();probeDevices();await loadDir('/data');histBtns()}init();"
"</script>";
  strncat(page,b,sizeof(page)-strlen(page)-1);
  v3_page_end(page,sizeof(page));
  send_text(fd,"200 OK","text/html; charset=utf-8",NULL,page);
}
