static void v3_profile_values(char uid[16],char name[64],int *has_avatar)
{
  char av[256];uid[0]=name[0]=0;if(v3_foreground_user(uid,name,av)!=0){snprintf(name,64,"PS5");snprintf(uid,16,"--------");*has_avatar=0;return;}struct stat st;*has_avatar=(stat(av,&st)==0&&S_ISREG(st.st_mode));
}

