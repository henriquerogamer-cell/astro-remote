"<div class='head'><div><h1>Arquivos</h1><p>Gerenciador nativo do Astro.</p></div><div class='toolbar'><input id='fu' type='file' hidden><button onclick=\"fu.click()\">Upload</button><button onclick='mk()'>Nova pasta</button><button onclick='touchF()'>Novo arquivo</button></div></div>"
