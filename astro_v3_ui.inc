{
  char uid[16],name[64],en[160];int av=0;v3_profile_values(uid,name,&av);json_escape(name,en,sizeof(en));snprintf(out,os,
"<!doctype html><html lang='pt-BR'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>%s · Astro</title><style>%s</style></head><body><main class='shell'>"
"<header class='top'><div class='brand'>ASTRO<small>PS5 CONTROL DECK · V3</small></div><a class='profile' href='/profile'>%s<div><div class='pname'>%s</div><div class='pid'>User %s</div></div></a></header>"
"<nav class='nav'><a class='%s' href='/dashboard'>Painel</a><a class='%s' href='/payloads'>Payloads</a><a class='%s' href='/files'>Arquivos</a><a class='%s' href='/saves'>Saves</a><a class='%s' href='/homebrew'>Homebrew</a><a class='%s' href='/processes'>Processos</a><a class='%s' href='/services'>Serviços Web</a><a class='%s' href='/settings'>Ajustes</a><a href='/logout'>Sair</a></nav>",title,v3_css,av?"<img class='avatar' src='/api/profile/avatar' onerror=\"this.style.display='none'\">":"<div class='avatarFallback'>A</div>",en,uid,
!strcmp(active,"dashboard")?"active":"",!strcmp(active,"payloads")?"active":"",!strcmp(active,"files")?"active":"",!strcmp(active,"saves")?"active":"",!strcmp(active,"homebrew")?"active":"",!strcmp(active,"processes")?"active":"",!strcmp(active,"services")?"active":"",!strcmp(active,"settings")?"active":"");
}

static void v3_page_end(char*out,size_t os){strncat(out,"<div class='foot'>ASTRO v3 alpha · administração nativa do PS5</div></main></body></html>",os-strlen(out)-1);}

